---
import Layout from "../../layouts/Layout.astro";
import ArticleSchema from "../../components/ArticleSchema.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import ResourceByline from "../../components/ResourceByline.astro";

const errores = [
    {
        num: "01",
        title: "Tu CV describe, pero no posiciona",
        intro: "Mucha gente me muestra su CV y me dice:",
        quote: "“Pero si puse todo lo que hice”.",
        body: "Y sí. El problema es ese.",
        keyPoint:
            "Tu CV no existe para contar tu historia. Existe para hacer evidente por qué tú eres útil para ese rol.",
        closing:
            "Cuando solo describes funciones, el reclutador no ve valor. Ve lista. Y pasa de largo.",
    },
    {
        num: "02",
        title: "Estás vendiéndote como “todólogo”",
        intro: "Esto es súper común.",
        quote: "Un poco de todo, pero nada realmente definido.",
        body: "Resultado: perfil difuso.",
        keyPoint:
            "En selección, lo difuso no compite. Compite el que se ve claro.",
        closing:
            "Si no se entiende rápido qué tipo de profesional eres, te descartan. No porque seas malo. Porque no eres evidente.",
    },
    {
        num: "03",
        title: "Tu CV está escrito para ti, no para quien contrata",
        intro: "Esto es clave.",
        quote: "Tú lo entiendes. Tu jefe lo entendería. Tu equipo también.",
        body: "Pero el reclutador no vive en tu mundo.",
        keyPoint:
            "Si tu CV está lleno de siglas, jerga interna o contextos que solo se entienden “desde dentro”, se vuelve pesado de leer.",
        closing:
            "Y en procesos reales, nadie pelea por entenderte. Si cuesta, se suelta.",
    },
];
---

<Layout
    title="Por qué no te llaman (y no tiene que ver con tu suerte) | Recursos | Somos Empleables"
    description="Si estás postulando, cumples los requisitos y no te llaman, no es mala suerte. Los 3 errores estructurales que hacen invisible a tu CV."
>
    <Fragment slot="head">
        <ArticleSchema slug="por-que-no-te-llaman" />
        <BreadcrumbSchema slug="por-que-no-te-llaman" />
    </Fragment>
    <main class="relative w-full pt-32 pb-24 bg-slate-50">
        <!-- Hero Section -->
        <section
            class="max-w-5xl mx-auto px-6 mb-20 text-center relative"
        >
            <!-- Background Gradients -->
            <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-10 pointer-events-none overflow-hidden"
            >
                <div
                    class="absolute top-0 left-0 md:left-1/4 w-64 h-64 md:w-[500px] md:h-[500px] bg-blue-50 rounded-full blur-[60px] md:blur-[100px] opacity-70"
                >
                </div>
                <div
                    class="absolute top-0 right-0 md:right-1/4 w-64 h-64 md:w-[500px] md:h-[500px] bg-purple-100/40 rounded-full blur-[60px] md:blur-[100px] opacity-70"
                >
                </div>
            </div>

            <span
                class="inline-flex items-center gap-2 text-blue-700 font-semibold tracking-wide uppercase text-xs md:text-sm border border-blue-200 bg-blue-50 px-4 py-2 rounded-full mb-8 shadow-sm"
            >
                <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"
                ></span>
                Recurso · Posicionamiento
            </span>

            <h1
                class="text-4xl md:text-6xl font-extrabold tracking-tight text-slate-900 mb-6 leading-[1.1]"
            >
                Por qué no te llaman
                <br class="hidden md:block" />
                <span class="text-blue-600">(y no tiene que ver con tu suerte)</span>
            </h1>

            <p
                class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed"
            >
                Si estás postulando, cumples con los requisitos y aun así no
                te llaman, en la mayoría de los casos el problema es
                <strong class="text-slate-900">estructura</strong>.
            </p>
            <ResourceByline slug="por-que-no-te-llaman" />
        </section>

        <!-- Article -->
        <section class="max-w-3xl mx-auto px-6">
            <article>
                <!-- Intro -->
                <div class="mb-16 pb-10 border-b border-slate-200">
                    <p class="text-lg text-slate-700 leading-relaxed mb-4">
                        Voy a ser directo contigo.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Si estás postulando, tienes experiencia, cumples con los
                        requisitos… y aun así no te llaman,
                    </p>
                    <p
                        class="text-xl font-bold text-slate-900 leading-relaxed mb-4"
                    >
                        no es mala suerte.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Y tampoco es que el mercado esté imposible.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed">
                        En la mayoría de los casos, el problema es estructura. Y
                        acá es donde se están cayendo muchos perfiles buenos.
                    </p>
                </div>

                <!-- Errores -->
                {
                    errores.map((e) => (
                        <section class="mb-14">
                            <div class="flex items-baseline gap-4 mb-6">
                                <span class="text-blue-600 text-sm font-mono font-bold">
                                    Error #{e.num}
                                </span>
                            </div>
                            <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-6 leading-tight">
                                {e.title}
                            </h2>
                            <p class="text-base text-slate-600 leading-relaxed mb-4">
                                {e.intro}
                            </p>
                            <blockquote class="border-l-4 border-blue-600 pl-4 italic text-slate-700 my-5">
                                {e.quote}
                            </blockquote>
                            <p class="text-base text-slate-600 leading-relaxed mb-5">
                                {e.body}
                            </p>
                            <div class="bg-blue-50 border border-blue-100 rounded-2xl p-5 md:p-6 my-6">
                                <p class="text-base md:text-lg text-slate-900 leading-relaxed font-semibold">
                                    {e.keyPoint}
                                </p>
                            </div>
                            <p class="text-base text-slate-600 leading-relaxed">
                                {e.closing}
                            </p>
                        </section>
                    ))
                }

                <!-- Cierre -->
                <section class="mt-16 pt-10 border-t border-slate-200">
                    <h2
                        class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-6 leading-tight"
                    >
                        Ahora, lo importante
                    </h2>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Nada de esto significa que no seas bueno.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Significa que <strong class="text-slate-900"
                            >tu perfil no está siendo leído como debería</strong
                        >.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed mb-6">
                        Y esto es clave que lo entiendas:
                    </p>
                    <div
                        class="bg-slate-900 text-white rounded-2xl p-6 md:p-8 my-6"
                    >
                        <p class="text-lg md:text-xl leading-relaxed">
                            El mercado <strong>no premia al más capaz</strong>,
                            premia al
                            <strong class="text-blue-400"
                                >más claro en comunicar su valor</strong
                            >.
                        </p>
                    </div>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Cuando ordenas enfoque, narrativa y estructura, cambia
                        la respuesta.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        No porque te inventes algo.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed">
                        Sino porque por fin <strong class="text-slate-900"
                            >se entiende tu valor</strong
                        >.
                    </p>
                </section>

                <!-- CTA Final -->
                <section class="mt-16">
                    <div
                        class="bg-slate-900 rounded-3xl p-8 md:p-12 text-center text-white relative overflow-hidden"
                    >
                        <div
                            class="absolute -top-20 -right-20 w-64 h-64 bg-blue-600 rounded-full blur-[80px] opacity-30 pointer-events-none"
                        >
                        </div>
                        <div
                            class="absolute -bottom-20 -left-20 w-64 h-64 bg-purple-600 rounded-full blur-[80px] opacity-20 pointer-events-none"
                        >
                        </div>

                        <div class="relative">
                            <h3
                                class="text-2xl md:text-4xl font-extrabold mb-4 leading-tight"
                            >
                                ¿Te hizo sentido?
                            </h3>
                            <p
                                class="text-base md:text-lg text-slate-300 mb-8 max-w-2xl mx-auto leading-relaxed"
                            >
                                En <strong class="text-white"
                                    >Somos Empleables</strong
                                > te ayudamos a destrabar tu búsqueda. Responde
                                6 preguntas y te decimos exactamente qué te
                                está frenando.
                            </p>
                            <div
                                class="flex justify-center"
                            >
                                <a
                                    href="/quiz"
                                    class="inline-flex items-center justify-center gap-2 bg-white text-slate-900 hover:bg-slate-100 font-bold px-6 py-3 rounded-full transition-colors"
                                >
                                    Descubre qué te está frenando
                                    <span aria-hidden="true">→</span>
                                </a>
                            </div>
                            <p
                                class="text-sm text-slate-400 mt-8"
                            >
                                — Stefano Andreani · Somos Empleables
                            </p>
                        </div>
                    </div>
                </section>

                <!-- Back link -->
                <div class="mt-12 text-center">
                    <a
                        href="/recursos"
                        class="text-blue-600 font-semibold hover:underline"
                        >← Ver todos los recursos</a
                    >
                </div>
            </article>
        </section>
    </main>

    <footer
        class="bg-slate-900 text-slate-400 py-12 px-6 border-t border-slate-800 text-center text-sm"
    >
        <p>
            &copy; {new Date().getFullYear()} Somos Empleables. Todos los derechos
            reservados.
        </p>
    </footer>
</Layout>
