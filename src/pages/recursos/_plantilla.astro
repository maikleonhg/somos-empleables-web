---
// PLANTILLA para un recurso nuevo. Astro IGNORA archivos con prefijo "_".
// Pasos: (1) copiar este archivo a <slug>.astro, (2) reemplazar el contenido,
// (3) agregar la entrada correspondiente en src/data/recursos.ts.
import Layout from "../../layouts/Layout.astro";
import ArticleSchema from "../../components/ArticleSchema.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import ResourceByline from "../../components/ResourceByline.astro";

const SLUG = "REEMPLAZAR-CON-EL-SLUG"; // debe coincidir con el nombre del archivo y con recursos.ts
---

<Layout
    title="TÍTULO DEL RECURSO | Recursos | Somos Empleables"
    description="DESCRIPCIÓN DE 1-2 FRASES PARA SEO."
>
    <Fragment slot="head">
        <ArticleSchema slug={SLUG} />
        <BreadcrumbSchema slug={SLUG} />
    </Fragment>

    <main class="relative w-full pt-32 pb-24 bg-slate-50">
        <!-- Hero -->
        <section class="max-w-5xl mx-auto px-6 mb-20 text-center relative">
            <h1
                class="text-4xl md:text-6xl font-extrabold tracking-tight text-slate-900 mb-6 leading-[1.1]"
            >
                TÍTULO DEL RECURSO
            </h1>
            <p
                class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed"
            >
                SUBTÍTULO / GANCHO.
            </p>
            <ResourceByline slug={SLUG} />
        </section>

        <!-- Cuerpo del artículo -->
        <section class="max-w-3xl mx-auto px-6">
            <article>
                <p class="text-base text-slate-600 leading-relaxed mb-4">
                    CONTENIDO. Usar &lt;h2&gt; para subtítulos, &lt;blockquote&gt; para
                    citas, y bloques destacados para puntos clave (ver recursos existentes).
                </p>

                <!-- CTA Final -->
                <section class="mt-16">
                    <div
                        class="bg-slate-900 rounded-3xl p-8 md:p-12 text-center text-white relative overflow-hidden"
                    >
                        <div
                            class="absolute -top-20 -right-20 w-64 h-64 bg-blue-600 rounded-full blur-[80px] opacity-30 pointer-events-none"
                        >
                        </div>
                        <div
                            class="absolute -bottom-20 -left-20 w-64 h-64 bg-purple-600 rounded-full blur-[80px] opacity-20 pointer-events-none"
                        >
                        </div>

                        <div class="relative">
                            <h3
                                class="text-2xl md:text-4xl font-extrabold mb-4 leading-tight"
                            >
                                ¿Te hizo sentido?
                            </h3>
                            <p
                                class="text-base md:text-lg text-slate-300 mb-8 max-w-2xl mx-auto leading-relaxed"
                            >
                                En <strong class="text-white"
                                    >Somos Empleables</strong
                                > te ayudamos a destrabar tu búsqueda. Responde
                                6 preguntas y te decimos exactamente qué te
                                está frenando.
                            </p>
                            <div class="flex justify-center">
                                <a
                                    href="/quiz"
                                    class="inline-flex items-center justify-center gap-2 bg-white text-slate-900 hover:bg-slate-100 font-bold px-6 py-3 rounded-full transition-colors"
                                >
                                    Descubre qué te está frenando
                                    <span aria-hidden="true">→</span>
                                </a>
                            </div>
                            <p class="text-sm text-slate-400 mt-8">
                                — Stefano Andreani · Somos Empleables
                            </p>
                        </div>
                    </div>
                </section>

                <!-- Back link -->
                <div class="mt-12 text-center">
                    <a
                        href="/recursos"
                        class="text-blue-600 font-semibold hover:underline"
                        >← Ver todos los recursos</a
                    >
                </div>
            </article>
        </section>
    </main>

    <footer
        class="bg-slate-900 text-slate-400 py-12 px-6 border-t border-slate-800 text-center text-sm"
    >
        <p>
            &copy; {new Date().getFullYear()} Somos Empleables. Todos los derechos
            reservados.
        </p>
    </footer>
</Layout>
