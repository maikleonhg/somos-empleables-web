---
import Layout from "../../layouts/Layout.astro";

const diagnostico = [
    "Tu CV describe funciones, pero no resultados.",
    "Tu titular es genérico o poco intencional.",
    "En entrevistas improvisas esperando que “se note” tu potencial.",
    "Te incomoda hablar de impacto porque sientes que “fue poco”.",
    "Aceptarías cualquier renta “para no perder la oportunidad”.",
];
---

<Layout
    title="El mercado se mueve a tu ritmo | Recursos | Somos Empleables"
    description="Cuando tu valor no se entiende rápido, las oportunidades pasan. Mini diagnóstico + 3 señales que abren ventanas: CV, entrevistas y negociación."
>
    <main class="relative w-full pt-32 pb-24 bg-slate-50">
        <!-- Hero Section -->
        <section
            class="max-w-5xl mx-auto px-6 mb-20 text-center relative"
        >
            <!-- Background Gradients -->
            <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-10 pointer-events-none overflow-hidden"
            >
                <div
                    class="absolute top-0 left-0 md:left-1/4 w-64 h-64 md:w-[500px] md:h-[500px] bg-blue-50 rounded-full blur-[60px] md:blur-[100px] opacity-70"
                >
                </div>
                <div
                    class="absolute top-0 right-0 md:right-1/4 w-64 h-64 md:w-[500px] md:h-[500px] bg-purple-100/40 rounded-full blur-[60px] md:blur-[100px] opacity-70"
                >
                </div>
            </div>

            <span
                class="inline-flex items-center gap-2 text-blue-700 font-semibold tracking-wide uppercase text-xs md:text-sm border border-blue-200 bg-blue-50 px-4 py-2 rounded-full mb-8 shadow-sm"
            >
                <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"
                ></span>
                Recurso · Estrategia
            </span>

            <h1
                class="text-4xl md:text-6xl font-extrabold tracking-tight text-slate-900 mb-6 leading-[1.1]"
            >
                El mercado se mueve
                <br class="hidden md:block" />
                <span class="text-blue-600">a tu ritmo</span>
            </h1>

            <p
                class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed"
            >
                Cuando tu valor
                <strong class="text-slate-900">no se entiende rápido</strong>,
                las oportunidades pasan.
            </p>
        </section>

        <!-- Article -->
        <section class="max-w-3xl mx-auto px-6">
            <article>
                <!-- Intro -->
                <div class="mb-16 pb-10 border-b border-slate-200">
                    <p class="text-lg text-slate-700 leading-relaxed mb-4">
                        En el mercado laboral las oportunidades no esperan.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Aparecen, se abren… y se cierran.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        No te falta
                        <em class="text-slate-900 not-italic font-semibold"
                            >"más tiempo"</em
                        >. Te falta
                        <strong class="text-slate-900"
                            >claridad para que tu valor se entienda rápido</strong
                        >.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Porque cuando tu perfil no comunica bien lo que puedes
                        aportar, pasa algo simple:
                    </p>
                    <p
                        class="text-xl font-bold text-slate-900 leading-relaxed"
                    >
                        La puerta se cierra antes de que te vean.
                    </p>
                </div>

                <!-- Una escena real -->
                <section class="mb-16">
                    <h2
                        class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-6 leading-tight"
                    >
                        <span aria-hidden="true">🎬</span> Una escena real
                    </h2>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Dos personas postulan al mismo rol junior. Experiencia
                        parecida.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed mb-6">
                        Una entra a entrevista. La otra queda en visto.
                    </p>

                    <div
                        class="bg-blue-50 border border-blue-200 rounded-2xl p-5 md:p-6 my-6"
                    >
                        <p class="text-base text-slate-700 leading-relaxed mb-3">
                            La diferencia casi nunca es
                            <strong class="text-slate-900">"más senior"</strong>.
                        </p>
                        <p
                            class="text-xl md:text-2xl font-extrabold text-blue-700"
                        >
                            Es más claro.
                        </p>
                    </div>

                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Porque en el mercado, la claridad viaja rápido:
                    </p>
                    <ul class="space-y-2 text-base text-slate-600 leading-relaxed mb-6 pl-4">
                        <li class="flex gap-3">
                            <span class="text-blue-600 shrink-0">•</span>
                            <span>Un titular claro</span>
                        </li>
                        <li class="flex gap-3">
                            <span class="text-blue-600 shrink-0">•</span>
                            <span>Una historia bien contada</span>
                        </li>
                        <li class="flex gap-3">
                            <span class="text-blue-600 shrink-0">•</span>
                            <span>Negociación sin pedir perdón</span>
                        </li>
                    </ul>
                    <p class="text-base text-slate-600 leading-relaxed">
                        Y cuando esas señales no están, pasa lo más común: tu
                        perfil se vuelve
                        <strong class="text-slate-900">fácil de ignorar</strong>.
                    </p>
                </section>

                <!-- La idea que necesitas ver -->
                <section class="mb-16 pt-10 border-t border-slate-200">
                    <h2
                        class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-6 leading-tight"
                    >
                        <span aria-hidden="true">🛣️</span> La idea que necesitas
                        ver
                    </h2>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Tu carrera no es una fila donde todos avanzan por turno.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Es más parecido a una autopista con salidas.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed mb-6">
                        Las oportunidades son esas salidas: aparecen y
                        desaparecen. Si no sabes hacia dónde vas,
                        <strong class="text-slate-900">puedes pasar de largo</strong>.
                    </p>

                    <div
                        class="bg-slate-900 text-white rounded-2xl p-6 md:p-8 my-6"
                    >
                        <p class="text-lg md:text-xl leading-relaxed font-bold mb-3">
                            El tiempo no premia.
                            <span class="text-blue-400">El tiempo expone.</span>
                        </p>
                        <p class="text-base md:text-lg text-slate-300 leading-relaxed">
                            Lo que realmente premia el mercado es moverse con
                            señales claras cuando aparece la oportunidad.
                        </p>
                    </div>
                </section>

                <!-- Mini diagnóstico -->
                <section class="mb-16 pt-10 border-t border-slate-200">
                    <h2
                        class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-6 leading-tight"
                    >
                        <span aria-hidden="true">🧭</span> Mini diagnóstico
                    </h2>
                    <p class="text-base text-slate-600 leading-relaxed mb-6">
                        Marca cuántas de estas frases te pasan hoy:
                    </p>

                    <div
                        class="bg-white border border-slate-200 rounded-2xl p-6 md:p-7 my-6 shadow-sm"
                    >
                        <ul class="space-y-4" id="diagnostico-list">
                            {
                                diagnostico.map((frase, i) => (
                                    <li>
                                        <label class="flex items-start gap-3 cursor-pointer group">
                                            <input
                                                type="checkbox"
                                                class="diagnostico-check mt-1.5 w-5 h-5 rounded border-slate-300 text-blue-600 focus:ring-blue-500 focus:ring-offset-0 cursor-pointer shrink-0"
                                                data-idx={i}
                                            />
                                            <span class="text-base text-slate-700 leading-relaxed group-hover:text-slate-900 transition-colors">
                                                {frase}
                                            </span>
                                        </label>
                                    </li>
                                ))
                            }
                        </ul>

                        <div
                            id="diagnostico-resultado"
                            class="mt-6 pt-5 border-t border-slate-200 text-base text-slate-700 leading-relaxed"
                        >
                            <p>
                                <strong class="text-slate-900"
                                    >Resultado rápido:</strong
                                > si marcas 2 o más, probablemente no te falta experiencia.
                                Te falta
                                <strong class="text-blue-700"
                                    >estructura para mostrar tu valor</strong
                                >.
                            </p>
                            <p
                                id="diagnostico-conteo"
                                class="mt-3 text-sm text-slate-500 hidden"
                            >
                                Marcaste <span
                                    id="diagnostico-num"
                                    class="font-bold text-blue-700">0</span
                                > de 5.
                            </p>
                        </div>
                    </div>
                </section>

                <!-- Las 3 señales — intro -->
                <section class="mb-12 pt-10 border-t border-slate-200">
                    <h2
                        class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-6 leading-tight"
                    >
                        <span aria-hidden="true">✨</span> Las 3 señales que
                        abren ventanas
                    </h2>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Cuando tu perfil comunica bien, pasan cosas distintas.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed">
                        Los filtros se vuelven más fáciles. Las entrevistas
                        fluyen mejor. Y tu perfil se vuelve
                        <strong class="text-slate-900">más claro de elegir</strong>.
                    </p>
                </section>

                <!-- Señal 1 -->
                <section class="mb-14">
                    <h3
                        class="flex items-baseline gap-3 text-xl md:text-2xl font-bold text-slate-900 mb-5"
                    >
                        <span class="text-blue-600 text-base font-mono"
                            >Señal 1</span
                        >
                    </h3>
                    <h4 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-5 leading-tight">
                        Un CV que se entienda en segundos
                    </h4>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Los reclutadores no buscan solo años de experiencia.
                        Buscan señales de:
                    </p>
                    <ul class="space-y-2 text-base text-slate-600 leading-relaxed mb-6 pl-4">
                        <li class="flex gap-3">
                            <span class="text-blue-600 shrink-0">✓</span>
                            <span>Aprendizaje rápido</span>
                        </li>
                        <li class="flex gap-3">
                            <span class="text-blue-600 shrink-0">✓</span>
                            <span>Adaptación</span>
                        </li>
                        <li class="flex gap-3">
                            <span class="text-blue-600 shrink-0">✓</span>
                            <span>Resolución de problemas</span>
                        </li>
                        <li class="flex gap-3">
                            <span class="text-blue-600 shrink-0">✓</span>
                            <span>Responsabilidad progresiva</span>
                        </li>
                    </ul>

                    <div
                        class="bg-blue-50 border border-blue-200 rounded-2xl p-5 md:p-6 my-6"
                    >
                        <p class="text-base md:text-lg text-slate-900 leading-relaxed font-semibold">
                            <span class="text-blue-700">Regla simple:</span> cambia
                            tareas por
                            <strong>acción + herramienta + resultado</strong>.
                        </p>
                    </div>

                    <!-- Tabla antes/después -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-8">
                        <div
                            class="bg-red-50 border border-red-200 rounded-2xl p-5"
                        >
                            <div
                                class="flex items-center gap-2 text-red-700 font-bold uppercase text-xs tracking-wide mb-3"
                            >
                                <span aria-hidden="true">❌</span> Antes
                            </div>
                            <p class="text-base text-slate-700 leading-relaxed italic">
                                "Apoyo administrativo."
                            </p>
                        </div>
                        <div
                            class="bg-emerald-50 border border-emerald-200 rounded-2xl p-5"
                        >
                            <div
                                class="flex items-center gap-2 text-emerald-700 font-bold uppercase text-xs tracking-wide mb-3"
                            >
                                <span aria-hidden="true">✅</span> Después
                            </div>
                            <p class="text-base text-slate-700 leading-relaxed italic">
                                "Optimicé el registro de información en Excel,
                                reduciendo errores y mejorando tiempos de
                                respuesta."
                            </p>
                        </div>
                    </div>

                    <p class="text-base text-slate-600 leading-relaxed">
                        No necesitas logros gigantes. Necesitas
                        <strong class="text-slate-900"
                            >señales claras de impacto</strong
                        >.
                    </p>
                </section>

                <!-- Señal 2 -->
                <section class="mb-14 pt-10 border-t border-slate-200">
                    <h3
                        class="flex items-baseline gap-3 text-xl md:text-2xl font-bold text-slate-900 mb-5"
                    >
                        <span class="text-blue-600 text-base font-mono"
                            >Señal 2</span
                        >
                    </h3>
                    <h4 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-5 leading-tight">
                        Entrevistas con estructura
                    </h4>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Improvisar no es autenticidad.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed mb-6">
                        Muchas veces es
                        <strong class="text-slate-900">falta de preparación</strong>.
                    </p>

                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Antes de una entrevista, prepara al menos
                        <strong class="text-slate-900">tres historias</strong>:
                    </p>
                    <ul class="space-y-2 text-base text-slate-600 leading-relaxed mb-8 pl-4">
                        <li class="flex gap-3">
                            <span class="text-blue-600 shrink-0">•</span>
                            <span>Un problema que resolviste</span>
                        </li>
                        <li class="flex gap-3">
                            <span class="text-blue-600 shrink-0">•</span>
                            <span>Un error y qué aprendiste</span>
                        </li>
                        <li class="flex gap-3">
                            <span class="text-blue-600 shrink-0">•</span>
                            <span>Un desafío que asumiste</span>
                        </li>
                    </ul>

                    <p class="text-base text-slate-600 leading-relaxed mb-6">
                        Cuéntalas con esta estructura:
                    </p>

                    <!-- Flow Momento → Acción → Resultado -->
                    <div
                        class="grid grid-cols-1 md:grid-cols-3 gap-3 my-8"
                    >
                        <div
                            class="bg-white border-2 border-blue-200 rounded-2xl p-5 text-center"
                        >
                            <div
                                class="text-blue-600 font-mono text-sm font-bold uppercase tracking-wider mb-2"
                            >
                                Momento
                            </div>
                            <p class="text-base text-slate-700 leading-relaxed">
                                qué estaba pasando
                            </p>
                        </div>
                        <div
                            class="bg-white border-2 border-blue-200 rounded-2xl p-5 text-center"
                        >
                            <div
                                class="text-blue-600 font-mono text-sm font-bold uppercase tracking-wider mb-2"
                            >
                                Acción
                            </div>
                            <p class="text-base text-slate-700 leading-relaxed">
                                qué hiciste
                            </p>
                        </div>
                        <div
                            class="bg-blue-600 text-white rounded-2xl p-5 text-center"
                        >
                            <div
                                class="font-mono text-sm font-bold uppercase tracking-wider mb-2 text-blue-100"
                            >
                                Resultado
                            </div>
                            <p class="text-base leading-relaxed">
                                qué cambió
                            </p>
                        </div>
                    </div>

                    <p class="text-base text-slate-600 leading-relaxed mb-2">
                        Una idea clara por respuesta.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed">
                        Un mensaje que deje una
                        <strong class="text-slate-900">conclusión</strong>.
                    </p>
                </section>

                <!-- Señal 3 -->
                <section class="mb-14 pt-10 border-t border-slate-200">
                    <h3
                        class="flex items-baseline gap-3 text-xl md:text-2xl font-bold text-slate-900 mb-5"
                    >
                        <span class="text-blue-600 text-base font-mono"
                            >Señal 3</span
                        >
                    </h3>
                    <h4 class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-5 leading-tight">
                        Negociar sin subestimarte
                    </h4>
                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Aceptar una renta muy baja no siempre es estrategia.
                    </p>
                    <p class="text-base text-slate-600 leading-relaxed mb-6">
                        A veces es
                        <strong class="text-slate-900"
                            >miedo a perder la oportunidad</strong
                        >.
                    </p>

                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Antes de negociar:
                    </p>
                    <ul class="space-y-3 text-base text-slate-600 leading-relaxed mb-6 pl-4">
                        <li class="flex gap-3">
                            <span class="text-blue-600 shrink-0">•</span>
                            <span>Investiga el rango del rol</span>
                        </li>
                        <li class="flex gap-3">
                            <span class="text-blue-600 shrink-0">•</span>
                            <span>Define tu mínimo aceptable</span>
                        </li>
                        <li class="flex gap-3">
                            <span class="text-blue-600 shrink-0">•</span>
                            <span
                                >Prepara 2–3 razones que respalden tu número en
                                caso de ser necesario</span
                            >
                        </li>
                    </ul>

                    <p class="text-base text-slate-600 leading-relaxed mb-4">
                        Por ejemplo:
                    </p>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 my-6">
                        <div
                            class="bg-blue-50 border border-blue-200 rounded-2xl p-4 text-center"
                        >
                            <p class="text-base font-semibold text-slate-900">
                                Impacto demostrado
                            </p>
                        </div>
                        <div
                            class="bg-blue-50 border border-blue-200 rounded-2xl p-4 text-center"
                        >
                            <p class="text-base font-semibold text-slate-900">
                                Alcance del rol
                            </p>
                        </div>
                        <div
                            class="bg-blue-50 border border-blue-200 rounded-2xl p-4 text-center"
                        >
                            <p class="text-base font-semibold text-slate-900">
                                Referencia de mercado
                            </p>
                        </div>
                    </div>

                    <p class="text-base text-slate-600 leading-relaxed">
                        Cuando tu argumento es claro, tu número deja de sonar
                        <strong class="text-slate-900">improvisado</strong>.
                    </p>
                </section>

                <!-- Mini ejercicio -->
                <section class="mb-16 pt-10 border-t border-slate-200">
                    <h2
                        class="text-2xl md:text-3xl font-extrabold text-slate-900 mb-6 leading-tight"
                    >
                        <span aria-hidden="true">🛠️</span> Mini ejercicio para
                        las próximas 2 semanas
                    </h2>
                    <p class="text-base text-slate-600 leading-relaxed mb-6">
                        Haz tres cosas simples:
                    </p>

                    <div class="space-y-4">
                        <div
                            class="bg-white border border-slate-200 rounded-2xl p-5 flex gap-4 shadow-sm"
                        >
                            <div
                                class="shrink-0 w-10 h-10 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center"
                            >
                                1
                            </div>
                            <p class="text-base text-slate-700 leading-relaxed pt-1.5">
                                Escribe <strong class="text-slate-900"
                                    >3 bullets</strong
                                > de tu CV usando
                                <strong class="text-blue-700"
                                    >acción + herramienta + resultado</strong
                                >.
                            </p>
                        </div>
                        <div
                            class="bg-white border border-slate-200 rounded-2xl p-5 flex gap-4 shadow-sm"
                        >
                            <div
                                class="shrink-0 w-10 h-10 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center"
                            >
                                2
                            </div>
                            <p class="text-base text-slate-700 leading-relaxed pt-1.5">
                                Escribe <strong class="text-slate-900"
                                    >1 historia profesional</strong
                                > en 6 líneas usando
                                <strong class="text-blue-700"
                                    >Momento → Acción → Resultado</strong
                                >.
                            </p>
                        </div>
                        <div
                            class="bg-white border border-slate-200 rounded-2xl p-5 flex gap-4 shadow-sm"
                        >
                            <div
                                class="shrink-0 w-10 h-10 rounded-full bg-blue-600 text-white font-bold flex items-center justify-center"
                            >
                                3
                            </div>
                            <p class="text-base text-slate-700 leading-relaxed pt-1.5">
                                Define tu
                                <strong class="text-slate-900"
                                    >rango de renta</strong
                                > y una frase para justificarlo.
                            </p>
                        </div>
                    </div>

                    <p
                        class="text-base text-slate-600 leading-relaxed mt-8 italic"
                    >
                        No es un trabajo largo. Pero sí cambia mucho cómo se
                        entiende tu perfil.
                    </p>
                </section>

                <!-- CTA Final -->
                <section class="mt-16">
                    <div
                        class="bg-slate-900 rounded-3xl p-8 md:p-12 text-center text-white relative overflow-hidden"
                    >
                        <div
                            class="absolute -top-20 -right-20 w-64 h-64 bg-blue-600 rounded-full blur-[80px] opacity-30 pointer-events-none"
                        >
                        </div>
                        <div
                            class="absolute -bottom-20 -left-20 w-64 h-64 bg-purple-600 rounded-full blur-[80px] opacity-20 pointer-events-none"
                        >
                        </div>

                        <div class="relative">
                            <h3
                                class="text-2xl md:text-4xl font-extrabold mb-4 leading-tight"
                            >
                                ¿Te hizo sentido?
                            </h3>
                            <p
                                class="text-base md:text-lg text-slate-300 mb-8 max-w-2xl mx-auto leading-relaxed"
                            >
                                En <strong class="text-white"
                                    >Somos Empleables</strong
                                > publicamos recursos como este. Síguenos en Instagram
                                para no perderte los próximos.
                            </p>
                            <div class="flex justify-center">
                                <a
                                    href="https://www.instagram.com/somosempleables/"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center justify-center gap-2 bg-white text-slate-900 hover:bg-slate-100 font-bold px-6 py-3 rounded-full transition-colors"
                                >
                                    Síguenos en Instagram
                                    <span aria-hidden="true">→</span>
                                </a>
                            </div>
                            <p class="text-sm text-slate-400 mt-8">
                                — Stefano Andreani · Somos Empleables
                            </p>
                        </div>
                    </div>
                </section>

                <!-- Back link -->
                <div class="mt-12 text-center">
                    <a
                        href="/recursos"
                        class="text-blue-600 font-semibold hover:underline"
                        >← Ver todos los recursos</a
                    >
                </div>
            </article>
        </section>
    </main>

    <footer
        class="bg-slate-900 text-slate-400 py-12 px-6 border-t border-slate-800 text-center text-sm"
    >
        <p>
            &copy; {new Date().getFullYear()} Somos Empleables. Todos los derechos
            reservados.
        </p>
    </footer>
</Layout>

<script>
    const checks = document.querySelectorAll<HTMLInputElement>(
        ".diagnostico-check",
    );
    const conteoWrap = document.getElementById("diagnostico-conteo");
    const conteoNum = document.getElementById("diagnostico-num");

    function updateConteo() {
        const marcadas = Array.from(checks).filter((c) => c.checked).length;
        if (conteoNum) conteoNum.textContent = String(marcadas);
        if (conteoWrap) {
            if (marcadas > 0) conteoWrap.classList.remove("hidden");
            else conteoWrap.classList.add("hidden");
        }
    }
    checks.forEach((c) => c.addEventListener("change", updateConteo));
</script>
