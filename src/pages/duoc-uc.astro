---
import Layout from "../layouts/Layout.astro";

const etapas = [
    {
        num: "01",
        id: "etapa-1",
        title: "El Cimiento de la Empleabilidad",
        subtitle: "Autoconocimiento y Mentalidad",
    },
    {
        num: "02",
        id: "etapa-2",
        title: "Creación de un buen CV",
        subtitle: "El CV es un anuncio, no autobiografía",
    },
    {
        num: "03",
        id: "etapa-3",
        title: "La Entrevista",
        subtitle: "Preparación que diferencia",
    },
    {
        num: "04",
        id: "etapa-4",
        title: "Red de Contactos",
        subtitle: "LinkedIn como tu mejor aliado",
    },
];

// Titular profesional — ejemplos (Etapa 4)
const titularEjemplos = [
    { perfil: "Ingeniero Comercial", debil: "Ingeniero Comercial", fuerte: "Ingeniero Comercial · Estrategia Comercial y Análisis de Mercado · Crecimiento basado en datos" },
    { perfil: "Analista Financiero", debil: "Analista Financiero en [empresa]", fuerte: "Analista Financiero · Control de Gestión, FP&A y Reporting · Excel avanzado, Power BI y SAP" },
    { perfil: "Ingeniero Civil", debil: "Ingeniero Civil", fuerte: "Ingeniero Civil · Diseño y supervisión de proyectos de infraestructura sostenible" },
    { perfil: "Abogado", debil: "Abogado", fuerte: "Abogado Corporativo · Negociación y resolución de conflictos empresariales · M&A" },
    { perfil: "En transición laboral", debil: "Open to work", fuerte: "En búsqueda activa como Analista Financiero · Control de gestión y análisis de datos · Disponibilidad inmediata" },
];

// Aptitudes — ejemplos (Etapa 4)
const aptitudesEjemplos = [
    { perfil: "Analista de datos", tecnicas: "SQL, Power BI, Excel avanzado, Tableau, Análisis predictivo", blandas: "Pensamiento analítico, Comunicación efectiva, Resolución de problemas, Trabajo en equipo, Atención al detalle" },
    { perfil: "Ingeniero comercial / KAM", tecnicas: "Negociación B2B, Gestión de cuentas clave, Forecast comercial, CRM (Salesforce), Análisis de mercado", blandas: "Liderazgo, Comunicación persuasiva, Orientación a resultados, Manejo de stakeholders, Adaptabilidad" },
    { perfil: "Ingeniero civil", tecnicas: "AutoCAD, Revit, Gestión de proyectos, Planificación de obras, Lean Construction", blandas: "Liderazgo de equipos, Resolución de problemas, Toma de decisiones bajo presión, Coordinación multidisciplinaria, Comunicación técnica" },
];


// 10 preguntas que siempre caen (Etapa 3)
const preguntasFrecuentes = [
    "Háblame de ti / Preséntate.",
    "¿Por qué te interesa este cargo y esta empresa?",
    "Cuéntame de un proyecto que hayas liderado (objetivo, acción, resultado).",
    "Cuéntame de un conflicto o desacuerdo con un colega.",
    "¿Cuál es tu mayor fortaleza? (con ejemplo)",
    "¿Cuál es tu debilidad o área de mejora? (con plan de acción)",
    "¿Por qué saliste / quieres salir de tu trabajo actual?",
    "¿Cómo te ves en 2-3 años? / ¿Cuáles serían tus primeros 90 días?",
    "¿Cuál es tu expectativa de renta?",
    "¿Tienes preguntas para nosotros?",
];

// Checklist final CV (Etapa 2)
const cvChecklist = [
    { n: 1, check: "Formato 1 columna, sin foto, PDF", q: "¿Pasa un ATS?" },
    { n: 2, check: "Primera página con perfil + último cargo desarrollado", q: "¿Si solo lee la página 1, queda claro qué vendo?" },
    { n: 3, check: "Perfil profesional ≤ 4 líneas con número y palabras clave", q: "¿Vendo en 6 segundos?" },
    { n: 4, check: "Cada cargo tiene entre 4-5 funciones clave, con herramientas y, si es posible, logros cuantificados", q: "¿Hay logros o solo funciones?" },
    { n: 5, check: "El CV incluye las palabras clave de la oferta (las máximas posibles)", q: "¿El ATS encuentra lo que busca?" },
    { n: 6, check: "Herramientas con nivel y contexto", q: "¿\"Excel avanzado\" o solo \"Excel\"?" },
    { n: 7, check: "Versión adaptada al cargo específico (no genérica)", q: "¿Este CV fue hecho para esta oferta?" },
];

// Tipos de entrevista (Etapa 3)
const tiposEntrevista = [
    { tipo: "Screening telefónico", quien: "Reclutador junior / atracción de talento", evalua: "Disponibilidad, renta, experiencia mínima, motivación básica. Filtro inicial.", prep: "Tono energético, respuestas cortas y firmes. Tener renta y fecha de inicio listas." },
    { tipo: "Entrevista por competencias", quien: "Reclutador / psicólogo organizacional", evalua: "Competencias blandas con método MAR, coherencia, autoconocimiento.", prep: "Banco de ejemplos MAR listo. Practicar conflicto, error y trabajo en equipo." },
    { tipo: "Entrevista técnica", quien: "Hiring manager / par técnico", evalua: "Dominio real del oficio, herramientas, decisiones técnicas, trade-offs.", prep: "Repasar herramientas con ejemplos concretos. Preparar 1-2 casos de decisiones técnicas." },
    { tipo: "Entrevista psicolaboral", quien: "Psicólogo externo", evalua: "Coherencia narrativa, manejo emocional, fit cultural, debilidades reales.", prep: "Historia de vida consistente. Errores reales. NO decir \"soy perfeccionista\"." },
    { tipo: "Entrevista final con gerencia", quien: "Gerente / Director", evalua: "Visión, motivación de largo plazo, fit estratégico, negociación.", prep: "Investigar a fondo. Preguntas inteligentes sobre el negocio. Proyección a 2-3 años." },
];

// Checklist 24 horas antes (Etapa 3, sección 7)
const entrevistaChecklist24h = [
    { n: 1, check: "Investigué la empresa (5 datos concretos) y al entrevistador (LinkedIn)" },
    { n: 2, check: "Identifiqué si es reclutador o hiring manager y ajusté el enfoque" },
    { n: 3, check: "Tengo lista mi versión de \"Háblame de ti\" en 90-120 seg (Pasado-Presente-Futuro)" },
    { n: 4, check: "Tengo 3 a 5 historias MAR diferentes, una por competencia" },
    { n: 5, check: "Tengo mi narrativa de salida del trabajo anterior en una versión simple" },
    { n: 6, check: "Tengo mi rango de renta listo, sin preámbulos" },
    { n: 7, check: "Tengo 3 preguntas preparadas para el entrevistador" },
    { n: 8, check: "Probé cámara, micrófono, fondo y luz" },
    { n: 9, check: "CV abierto en otra pestaña y vaso de agua a mano" },
    { n: 10, check: "Practiqué en voz alta con cronómetro al menos 1 vez" },
];

// Innegociables del CV (Etapa 2)
const cvInnegociables = [
    { titulo: "Formato ATS-friendly", body: "Una sola columna, vertical, sin foto, sin barras laterales ni íconos decorativos. PDF limpio, sin tablas anidadas. Como regla general, <strong>2 páginas</strong> (o 1 si tienes menos de 2 años de experiencia)." },
    { titulo: "Perfil Profesional fuerte en los primeros 4 renglones", body: "Años de experiencia + área, 2–3 fortalezas validadas externamente, 1 logro destacado cuantificado y las palabras clave del cargo objetivo. Es <strong>lo único garantizado</strong> que va a leer el reclutador." },
    { titulo: "Logros cuantificados (formato MAR) bajo cada experiencia", body: "No solo funciones, <strong>logros</strong>. Los números son el principal diferenciador: le permiten al reclutador validar el impacto de tu trabajo. Un CV sin datos cuantitativos o porcentajes pierde fuerza y se ve genérico." },
    { titulo: "La oferta es tu spoiler: adapta los CVs a lo que aparece en ella", body: "Leer la descripción del cargo función por función, subrayar las palabras clave (ej. <em>\"riesgo operacional\", \"KRI\", \"SLA\", \"stakeholders\", \"Lean\", \"SAP\", \"Power BI\"</em>) y verificar una por una que aparezcan en el CV, idealmente en la primera página. La IA y el reclutador buscan <strong>coincidencias exactas</strong>, no infieren." },
    { titulo: "Herramientas con nivel y contexto", body: "En lugar de listar <em>\"Excel, SQL, Power BI\"</em>, escribir <em>\"Excel avanzado (tablas dinámicas, Power Query), SQL intermedio, Power BI (modelado DAX y dashboards ejecutivos)\"</em>." },
    { titulo: "No un solo CV — sí 1 maestro + 2 a 3 versiones adaptadas", body: "Postular con un único CV genérico es la causa #1 del síndrome <em>\"postulo y nadie me llama\"</em>. Las versiones adaptadas comparten ~80% del contenido; cambian el perfil profesional, el orden de los logros y las palabras clave según el cargo." },
];

// Errores comunes (Etapa 3)
const erroresEntrevista = [
    { error: "Respuestas largas (5+ minutos)", duele: "El reclutador se desconecta y queda con la impresión de poca síntesis.", antidoto: "Cronómetro al practicar. Máximo 2 min por respuesta, 3 para \"háblame de ti\"." },
    { error: "Repetir el mismo ejemplo 4-5 veces", duele: "Da la impresión de que solo tienes una experiencia válida.", antidoto: "Tener 3 a 5 historias MAR distintas, una por tipo de competencia." },
    { error: "Bloquearse con preguntas simples (\"¿con quién vives?\")", duele: "Un psicólogo lee inseguridad u ocultamiento.", antidoto: "Practicar 5 respuestas personales cortas y naturales." },
    { error: "Justificar antes de afirmar", duele: "Cada palabra previa al número/respuesta lo debilita.", antidoto: "Afirmar primero, complementar solo si preguntan." },
    { error: "Sobreexplicar lo técnico", duele: "Si el reclutador no es técnico, se pierde. Si lo es, ya lo sabe.", antidoto: "Resultado primero, detalle técnico solo si lo piden." },
    { error: "Hablar mal de la empresa anterior", duele: "Bandera roja universal: si hablas mal de ellos hoy, hablarás mal de nosotros mañana.", antidoto: "Hablar de \"hacia dónde voy\", no de \"de qué huyo\"." },
    { error: "Caer en \"soy perfeccionista\" como debilidad", duele: "Cliché que destruye credibilidad y autoconocimiento.", antidoto: "Debilidad real + plan de gestión actual." },
    { error: "Tono plano / poca energía", duele: "Especialmente en screening telefónico: te interpretan como desmotivado.", antidoto: "Sonreír mientras hablas (se escucha). Subir 10% la energía habitual." },
    { error: "No investigar la empresa", duele: "Si el entrevistador lleva años ahí, lo detecta al instante.", antidoto: "5 datos concretos antes de entrar: modelo, clientes, noticias, valores, equipo." },
    { error: "No tener preguntas al final", duele: "Se interpreta como falta de interés genuino.", antidoto: "Llegar con 3 preguntas escritas. Hacer mínimo 2." },
];
---

<Layout
    title="Cómo construir tu empleabilidad | Material Duoc UC | Somos Empleables"
    description="Material complementario a la charla de Stefano Andreani en Duoc UC. Las 4 etapas para construir tu empleabilidad: autoconocimiento, herramientas, búsqueda y entrevistas."
>
    <main class="relative w-full pt-32 pb-24 bg-slate-50">
        <!-- Hero Section -->
        <section
            class="max-w-5xl mx-auto px-6 mb-20 text-center relative"
        >
            <!-- Background Gradients -->
            <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-10 pointer-events-none overflow-hidden"
            >
                <div
                    class="absolute top-0 left-0 md:left-1/4 w-64 h-64 md:w-[500px] md:h-[500px] bg-blue-50 rounded-full blur-[60px] md:blur-[100px] opacity-70"
                >
                </div>
                <div
                    class="absolute top-0 right-0 md:right-1/4 w-64 h-64 md:w-[500px] md:h-[500px] bg-purple-100/40 rounded-full blur-[60px] md:blur-[100px] opacity-70"
                >
                </div>
            </div>

            <span
                class="inline-flex items-center gap-2 text-blue-700 font-semibold tracking-wide uppercase text-[10px] md:text-xs border border-blue-200 bg-blue-50 px-3 py-1.5 rounded-full mb-8 shadow-sm"
            >
                <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"
                ></span>
                Material de la charla — Duoc UC
            </span>

            <h1
                class="text-4xl md:text-6xl font-extrabold tracking-tight text-slate-900 mb-6 leading-[1.1]"
            >
                Cómo construir <br class="hidden md:block" />
                tu <span class="text-blue-600">empleabilidad</span>
            </h1>

            <p
                class="text-lg md:text-xl text-slate-600 max-w-2xl mx-auto leading-relaxed"
            >
                Material complementario a la charla de <strong
                    class="text-slate-900">Stefano Andreani</strong
                >. Las 4 etapas para llevar tu carrera al siguiente nivel.
            </p>
        </section>

        <!-- TOC + Content -->
        <section class="relative max-w-7xl mx-auto px-6">
            <!-- Sticky TOC (absolute, left edge of section, only on xl+) -->
            <aside
                class="hidden xl:block absolute left-6 top-0 h-full pointer-events-none"
            >
                <nav
                    class="sticky top-32 w-52 space-y-1 pointer-events-auto"
                >
                    <p
                        class="text-xs font-bold text-slate-500 uppercase tracking-wider mb-4 px-3"
                    >
                        Contenido
                    </p>
                    {
                        etapas.map((e) => (
                            <a
                                href={`#${e.id}`}
                                data-toc-link={e.id}
                                class="toc-link block px-3 py-3 rounded-lg text-slate-600 hover:bg-blue-50 hover:text-blue-700 transition-colors group"
                            >
                                <div class="flex items-baseline gap-3">
                                    <span class="text-xs font-bold text-slate-400 group-hover:text-blue-500 font-mono">
                                        {e.num}
                                    </span>
                                    <div class="flex-1">
                                        <span class="block text-sm font-semibold leading-snug">
                                            {e.title}
                                        </span>
                                        <span class="block text-xs text-slate-400 mt-0.5">
                                            {e.subtitle}
                                        </span>
                                    </div>
                                </div>
                            </a>
                        ))
                    }
                </nav>
            </aside>

            <!-- Centered Article -->
            <article class="max-w-3xl mx-auto">
                    <!-- ============== ETAPA 1 ============== -->
                    <section id="etapa-1" class="scroll-mt-28">
                        <div
                            class="mb-10 pb-8 border-b border-slate-200"
                        >
                            <span
                                class="inline-block bg-blue-600 text-white text-xs font-bold tracking-wider uppercase px-3 py-1.5 rounded-full mb-4"
                            >
                                Etapa 01
                            </span>
                            <h2
                                class="text-3xl md:text-4xl font-extrabold text-slate-900 leading-tight mb-3"
                            >
                                El Cimiento de la Empleabilidad
                            </h2>
                            <p class="text-xl text-slate-500 font-light">
                                Autoconocimiento y Mentalidad
                            </p>
                        </div>

                        <p
                            class="text-xl text-slate-800 font-medium mb-6 leading-relaxed"
                        >
                            Esta etapa suele ser la más ignorada, pero es la más
                            crítica. Antes de escribir una sola palabra en un
                            currículum o sentarse frente a un reclutador, el
                            profesional debe realizar una <strong
                                >auditoría profunda de su perfil</strong
                            >.
                        </p>

                        <p
                            class="text-base text-slate-600 leading-relaxed mb-6"
                        >
                            Un candidato que no comprende su propio valor es
                            incapaz de proyectarlo. Esta fase se divide en dos
                            grandes ejes: el <strong class="text-slate-900"
                                >análisis técnico</strong
                            > y el <strong class="text-slate-900"
                                >análisis psicológico</strong
                            >.
                        </p>

                        <!-- 1. El Análisis del Perfil -->
                        <h3
                            class="flex items-baseline gap-3 text-2xl font-bold text-slate-900 mt-14 mb-5"
                        >
                            <span class="text-blue-600 text-base font-mono"
                                >01.</span
                            >
                            El Análisis del Perfil Profesional
                        </h3>
                        <p class="text-slate-600 leading-relaxed mb-6">
                            No se trata solo de recordar dónde trabajaste, sino
                            de convertirte en un <strong class="text-slate-900"
                                >experto de tu propia trayectoria</strong
                            >. Debes desglosar meticulosamente cada etapa de tu
                            carrera bajo los siguientes puntos:
                        </p>
                        <ul class="space-y-4 mb-6">
                            <li
                                class="bg-white p-5 rounded-xl border border-slate-100"
                            >
                                <p
                                    class="font-bold text-slate-900 mb-1.5"
                                >
                                    Dominio de la Experiencia
                                </p>
                                <p
                                    class="text-slate-600 leading-relaxed text-sm md:text-base"
                                >
                                    Debes tener total claridad sobre las
                                    responsabilidades que asumiste, las
                                    herramientas técnicas que dominas y las
                                    metodologías que aplicaste en el día a día.
                                    Es fundamental entender con qué áreas
                                    interactuabas y, sobre todo, qué problema
                                    específico venía a resolver tu cargo dentro
                                    de la organización.
                                </p>
                            </li>
                            <li
                                class="bg-white p-5 rounded-xl border border-slate-100"
                            >
                                <p
                                    class="font-bold text-slate-900 mb-1.5"
                                >
                                    Competencias con Respaldo
                                </p>
                                <p
                                    class="text-slate-600 leading-relaxed text-sm md:text-base"
                                >
                                    Las habilidades blandas no pueden ser solo
                                    etiquetas. Si afirmas tener "Liderazgo" o
                                    "Capacidad Analítica", debes tener preparado
                                    un ejemplo concreto de tu pasado laboral que
                                    funcione como <strong class="text-slate-900"
                                        >evidencia irrefutable</strong
                                    > de esa capacidad.
                                </p>
                            </li>
                        </ul>

                        <!-- 2. Método MAR -->
                        <h3
                            class="flex items-baseline gap-3 text-2xl font-bold text-slate-900 mt-14 mb-5"
                        >
                            <span class="text-blue-600 text-base font-mono"
                                >02.</span
                            >
                            La Extracción de Logros: El Método MAR
                        </h3>
                        <p class="text-slate-600 leading-relaxed mb-8">
                            Los logros son el <strong class="text-slate-900"
                                >lenguaje universal de la empleabilidad</strong
                            >; son lo que te permite destacar entre perfiles
                            similares. Para que un logro sea contundente, debe
                            estructurarse de forma que el impacto sea evidente.
                            Usamos el método <strong class="text-slate-900"
                                >MAR (Momento, Acción, Resultado)</strong
                            >:
                        </p>

                        <!-- MAR Cards -->
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
                            <div
                                class="relative bg-linear-to-br from-blue-50 to-white p-6 rounded-2xl border border-blue-100 shadow-sm"
                            >
                                <span
                                    class="block text-6xl font-extrabold text-blue-200 leading-none mb-3 select-none"
                                    >M</span
                                >
                                <p
                                    class="text-xs text-blue-600 uppercase tracking-wider font-bold mb-1"
                                >
                                    El Contexto
                                </p>
                                <h4
                                    class="text-lg font-bold text-slate-900 mb-3"
                                >
                                    Momento
                                </h4>
                                <p
                                    class="text-sm text-slate-600 leading-relaxed"
                                >
                                    El escenario o problema inicial. <em
                                        >Ej:</em
                                    > en tu práctica detectas que el equipo arma
                                    el reporte semanal de ventas a mano, copiando
                                    datos entre 4 planillas y tardando 6 horas
                                    cada lunes.
                                </p>
                            </div>
                            <div
                                class="relative bg-linear-to-br from-purple-50 to-white p-6 rounded-2xl border border-purple-100 shadow-sm"
                            >
                                <span
                                    class="block text-6xl font-extrabold text-purple-200 leading-none mb-3 select-none"
                                    >A</span
                                >
                                <p
                                    class="text-xs text-purple-600 uppercase tracking-wider font-bold mb-1"
                                >
                                    La Ejecución
                                </p>
                                <h4
                                    class="text-lg font-bold text-slate-900 mb-3"
                                >
                                    Acción
                                </h4>
                                <p
                                    class="text-sm text-slate-600 leading-relaxed"
                                >
                                    Los pasos técnicos y estratégicos que
                                    tomaste. <em>Ej:</em> unificaste las 4
                                    planillas en una sola con tablas dinámicas
                                    y fórmulas que se actualizan al pegar los
                                    datos del CRM. Capacitaste a 2 personas en
                                    30 minutos.
                                </p>
                            </div>
                            <div
                                class="relative bg-linear-to-br from-green-50 to-white p-6 rounded-2xl border border-green-100 shadow-sm"
                            >
                                <span
                                    class="block text-6xl font-extrabold text-green-200 leading-none mb-3 select-none"
                                    >R</span
                                >
                                <p
                                    class="text-xs text-green-600 uppercase tracking-wider font-bold mb-1"
                                >
                                    El Impacto
                                </p>
                                <h4
                                    class="text-lg font-bold text-slate-900 mb-3"
                                >
                                    Resultado
                                </h4>
                                <p
                                    class="text-sm text-slate-600 leading-relaxed"
                                >
                                    La consecuencia directa, idealmente en
                                    números. <em>Ej:</em> el reporte ahora toma
                                    30 minutos (–92%), liberaste ~22 horas al
                                    mes del equipo y te ofrecieron extender la
                                    práctica.
                                </p>
                            </div>
                        </div>

                        <!-- 3. Autodiagnóstico -->
                        <h3
                            class="flex items-baseline gap-3 text-2xl font-bold text-slate-900 mt-14 mb-5"
                        >
                            <span class="text-blue-600 text-base font-mono"
                                >03.</span
                            >
                            El Autodiagnóstico
                        </h3>
                        <p class="text-slate-600 leading-relaxed mb-6">
                            Entender tu identidad profesional implica conocer
                            tanto tus <strong class="text-slate-900"
                                >luces como tus sombras</strong
                            > para presentarlas de forma estratégica.
                        </p>
                        <ul class="space-y-4 mb-4">
                            <li
                                class="bg-white p-5 rounded-xl border border-slate-100"
                            >
                                <p
                                    class="font-bold text-slate-900 mb-1.5"
                                >
                                    Fortalezas
                                </p>
                                <p
                                    class="text-slate-600 leading-relaxed text-sm md:text-base"
                                >
                                    No se trata solo de un ejercicio de
                                    introspección; son tu diferencial, lo que
                                    te da ventaja respecto a otros perfiles.
                                    Los reclutadores las preguntan porque
                                    buscan <strong class="text-slate-900"
                                        >predecir tu desempeño futuro</strong
                                    > basándose en tus éxitos pasados. Hazte una
                                    lista con <strong class="text-slate-900"
                                        >3 o 4 fortalezas</strong
                                    > y explica cuándo, en tu trabajo o estudios,
                                    demostraste cada una.
                                </p>
                            </li>
                            <li
                                class="bg-white p-5 rounded-xl border border-slate-100"
                            >
                                <p
                                    class="font-bold text-slate-900 mb-1.5"
                                >
                                    Debilidades
                                </p>
                                <p
                                    class="text-slate-600 leading-relaxed text-sm md:text-base"
                                >
                                    Los reclutadores no buscan descartarte por
                                    tus fallos, sino evaluar tu <strong
                                        class="text-slate-900"
                                        >autoconsciencia y honestidad</strong
                                    >. Un candidato que afirma no tener
                                    debilidades proyecta falta de autocrítica
                                    o estancamiento. Quieren ver que eres capaz
                                    de identificar tus puntos de mejora y, sobre
