<script>
    // Active section tracking for the sticky TOC
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
    const sections = document.querySelectorAll<HTMLElement>("article > section[id]");

    if (links.length && sections.length) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const id = entry.target.id;
                        links.forEach((link) => {
                            const isActive =
                                link.getAttribute("data-toc-link") === id;
                            link.classList.toggle("bg-blue-50", isActive);
                            link.classList.toggle("text-blue-700", isActive);
                        });
                    }
                });
            },
            { rootMargin: "-30% 0px -60% 0px" }
        );

        sections.forEach((s) => observer.observe(s));
    }
</script>
