                        </ul>

                        <!-- 2. Tipos de entrevista -->
                        <h3
                            class="flex items-baseline gap-3 text-2xl font-bold text-slate-900 mt-14 mb-5"
                        >
                            <span class="text-blue-600 text-base font-mono"
                                >02.</span
                            >
                            Los tipos de entrevista
                        </h3>
                        <p class="text-slate-600 leading-relaxed mb-6">
                            Conocer el tipo te permite preparar la respuesta
                            correcta:
                        </p>

                        <div
                            class="overflow-x-auto rounded-2xl border border-slate-200 mb-8"
                        >
                            <table class="w-full text-sm min-w-[640px]">
                                <thead class="bg-slate-100">
                                    <tr>
                                        <th
                                            class="px-4 py-3 text-left font-bold text-slate-700"
                                            >Tipo</th
                                        >
                                        <th
                                            class="px-4 py-3 text-left font-bold text-slate-700"
                                            >Quién la hace</th
                                        >
                                        <th
                                            class="px-4 py-3 text-left font-bold text-slate-700"
                                            >Qué evalúa</th
                                        >
                                        <th
                                            class="px-4 py-3 text-left font-bold text-slate-700"
                                            >Cómo prepararla</th
                                        >
                                    </tr>
                                </thead>
                                <tbody
                                    class="bg-white divide-y divide-slate-100"
                                >
                                    {
                                        tiposEntrevista.map((t) => (
