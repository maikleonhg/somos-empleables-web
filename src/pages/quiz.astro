---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Evaluación profesional gratuita — Somos Empleables"
    description="Responde 7 preguntas y recibe un diagnóstico personalizado de qué te está frenando en tu búsqueda laboral."
>
    {/* aria-live va acá y no en un contenedor interno: este elemento es el
        único que NO se reemplaza (solo su innerHTML), y una región viva que
        nace junto con el contenido no la anuncia ningún lector de pantalla.
        Sin esto el quiz avanza de pregunta en silencio absoluto. */}
    <main id="quiz-root" class="quiz-root" aria-live="polite"></main>
</Layout>

<style>
    /* ============================================================
       Port de /root/apps/se-quiz/src/index.css
       Astro scopea este bloque solo a esta página, así que no
       hace falta reescribirlo a Tailwind ni prefijar selectores.
       Se mantiene tal cual el original salvo el body (se deja el
       fondo/tipografía general al Layout) y dos clases nuevas al
       final (pantalla de carga + accesibilidad) que no existían
       en el original.
       ============================================================ */

    .quiz-root {
        --brand: #2563eb;
        --brand-dark: #1d4ed8;
        --brand-light: #eff6ff;
        --text-primary: #111827;
        --text-secondary: #6b7280;
        --bg: #f8f7f4;
        --card-bg: #ffffff;
        --border: #e5e7eb;
        --radius: 14px;
        --shadow: 0 1px 3px rgba(0, 0, 0, 0.07), 0 4px 16px rgba(0, 0, 0, 0.05);
        /* Alto de la navbar fija del sitio (Navbar.astro: py-4 + botón de
           40px + borde inferior). El quiz vive debajo de ella, así que todas
           las pantallas reservan este espacio arriba y la barra de progreso
           arranca aquí en vez de taparla. */
        --nav-h: 73px;

        display: block;
        /* Sin font-family propia: hereda la Inter que carga Layout.astro
           (el original cargaba DM Sans en su propio index.html; acá no
           se pide esa fuente para no sumar una petición extra a Google
           Fonts y para que el quiz se vea consistente con el resto del
           sitio). */
        background: var(--bg);
        color: var(--text-primary);
        -webkit-font-smoothing: antialiased;
    }

    /* ─── Progress bar ─── */
    .quiz-root :global(.progress-bar) {
        position: fixed;
        top: var(--nav-h);
        left: 0;
        right: 0;
        height: 3px;
        background: var(--border);
        z-index: 100;
    }
    .quiz-root :global(.progress-fill) {
        height: 100%;
        background: var(--brand);
        transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* ─── Layout ─── */
    .quiz-root :global(.quiz-wrapper) {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: calc(48px + var(--nav-h)) 16px 32px;
    }
    .quiz-root :global(.quiz-container) {
        width: 100%;
        max-width: 480px;
        display: flex;
        flex-direction: column;
        gap: 24px;
    }

    /* ─── Header row ─── */
    .quiz-root :global(.step-header) {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .quiz-root :global(.step-counter) {
        font-size: 13px;
        font-weight: 500;
        color: var(--text-secondary);
        letter-spacing: 0.02em;
    }
    .quiz-root :global(.back-btn) {
        font-size: 13px;
        font-weight: 500;
        color: var(--text-secondary);
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px 0;
        transition: color 0.15s;
    }
    .quiz-root :global(.back-btn:hover) {
        color: var(--text-primary);
    }

    /* ─── Step animation ─── */
    @keyframes stepEnter {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    .quiz-root :global(.step-content) {
        animation: stepEnter 0.32s cubic-bezier(0.4, 0, 0.2, 1) both;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    /* ─── Question ─── */
    .quiz-root :global(.question) {
        font-size: 22px;
        font-weight: 600;
        line-height: 1.35;
        color: var(--text-primary);
    }

    /* ─── Options grid ─── */
    .quiz-root :global(.options-grid) {
        display: grid;
        gap: 10px;
    }
    .quiz-root :global(.grid-2) {
        grid-template-columns: 1fr 1fr;
    }
    .quiz-root :global(.grid-1) {
        grid-template-columns: 1fr;
    }
    @media (max-width: 380px) {
        .quiz-root :global(.grid-2) {
            grid-template-columns: 1fr;
        }
    }

    /* ─── Option card ─── */
    .quiz-root :global(.option-card) {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        padding: 16px;
        background: var(--card-bg);
        border: 1.5px solid var(--border);
        border-radius: var(--radius);
        cursor: pointer;
        text-align: left;
        transition:
            border-color 0.15s,
            background 0.15s,
            transform 0.12s,
            box-shadow 0.15s;
        box-shadow: var(--shadow);
        width: 100%;
    }
    .quiz-root :global(.option-card:hover) {
        border-color: #93c5fd;
        transform: translateY(-1px);
        box-shadow: 0 4px 20px rgba(37, 99, 235, 0.12);
    }
    .quiz-root :global(.option-card.selected) {
        border-color: var(--brand);
        background: var(--brand-light);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }
    .quiz-root :global(.option-icon) {
        font-size: 22px;
        line-height: 1;
    }
    .quiz-root :global(.option-label) {
        font-size: 14px;
        font-weight: 500;
        color: var(--text-primary);
        line-height: 1.4;
    }

    /* ─── Form fields ─── */
    .quiz-root :global(.form-fields) {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .quiz-root :global(.field-input) {
        width: 100%;
        padding: 14px 16px;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        font-family: inherit;
        font-size: 15px;
        color: var(--text-primary);
        background: var(--card-bg);
        outline: none;
        transition:
            border-color 0.15s,
            box-shadow 0.15s;
        box-shadow: var(--shadow);
    }
    .quiz-root :global(.field-input:focus) {
        border-color: var(--brand);
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }
    .quiz-root :global(.field-input::placeholder) {
        color: #9ca3af;
    }
    .quiz-root :global(.field-error) {
        margin: -4px 0 0;
        font-size: 13px;
        line-height: 1.5;
        color: #b91c1c;
    }
    .quiz-root :global(.field-error[hidden]) {
        display: none;
    }
    .quiz-root :global(.field-consent) {
        margin: 4px 0 0;
        font-size: 12px;
        line-height: 1.5;
        color: #6b7280;
    }
    .quiz-root :global(.field-consent a) {
        color: inherit;
        text-decoration: underline;
    }
    .quiz-root :global(.sr-only) {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* ─── Next button ─── */
    .quiz-root :global(.next-btn) {
        width: 100%;
        padding: 15px 24px;
        background: var(--text-primary);
        color: white;
        border: none;
        border-radius: 10px;
        font-family: inherit;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition:
            opacity 0.15s,
            transform 0.12s;
        letter-spacing: 0.01em;
    }
    .quiz-root :global(.next-btn:hover:not(:disabled)) {
        opacity: 0.88;
        transform: translateY(-1px);
    }
    .quiz-root :global(.next-btn:disabled) {
        opacity: 0.35;
        cursor: not-allowed;
    }

    /* ─── Intro screen ─── */
    .quiz-root :global(.intro-wrapper) {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: calc(32px + var(--nav-h)) 16px 32px;
    }
    .quiz-root :global(.intro-card) {
        width: 100%;
        max-width: 440px;
        background: var(--card-bg);
        border-radius: 20px;
        padding: 40px 32px;
        box-shadow: 0 4px 32px rgba(0, 0, 0, 0.1);
        animation: stepEnter 0.45s cubic-bezier(0.4, 0, 0.2, 1) both;
        display: flex;
        flex-direction: column;
        gap: 18px;
        text-align: center;
    }
    .quiz-root :global(.intro-logo) {
        font-size: 13px;
        font-weight: 700;
        color: var(--brand);
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }
    .quiz-root :global(.intro-icon) {
        font-size: 40px;
        margin: 0 auto;
    }
    .quiz-root :global(.intro-title) {
        font-size: 26px;
        font-weight: 700;
        line-height: 1.3;
        color: var(--text-primary);
    }
    .quiz-root :global(.intro-subtitle) {
        font-size: 15px;
        color: var(--text-secondary);
        line-height: 1.65;
    }
    .quiz-root :global(.intro-pills) {
        display: flex;
        gap: 8px;
        justify-content: center;
        flex-wrap: wrap;
    }
    .quiz-root :global(.intro-pill) {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #f3f4f6;
        border-radius: 100px;
        padding: 6px 12px;
        font-size: 13px;
        font-weight: 500;
        color: var(--text-secondary);
    }
    .quiz-root :global(.intro-btn) {
        width: 100%;
        padding: 16px 24px;
        background: var(--brand);
        color: white;
        border: none;
        border-radius: 10px;
        font-family: inherit;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition:
            background 0.15s,
            transform 0.12s;
        margin-top: 4px;
    }
    .quiz-root :global(.intro-btn:hover) {
        background: var(--brand-dark);
        transform: translateY(-1px);
    }
    .quiz-root :global(.intro-time) {
        font-size: 13px;
        color: #9ca3af;
        margin-top: -4px;
    }

    /* ─── Result screen ─── */
    .quiz-root :global(.result-wrapper) {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: calc(40px + var(--nav-h)) 16px 40px;
    }
    .quiz-root :global(.result-card) {
        width: 100%;
        max-width: 480px;
        background: var(--card-bg);
        border-radius: 20px;
        padding: 36px 28px;
        box-shadow: 0 4px 32px rgba(0, 0, 0, 0.1);
        animation: stepEnter 0.45s cubic-bezier(0.4, 0, 0.2, 1) both;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    @keyframes checkPop {
        0% {
            transform: scale(0.5);
            opacity: 0;
        }
        60% {
            transform: scale(1.12);
        }
        100% {
            transform: scale(1);
            opacity: 1;
        }
    }
    .quiz-root :global(.result-check) {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #dcfce7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        animation: checkPop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.25s both;
    }
    .quiz-root :global(.result-label) {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--brand);
    }
    .quiz-root :global(.result-greeting) {
        font-size: 15px;
        color: var(--text-secondary);
    }
    .quiz-root :global(.result-greeting strong) {
        color: var(--text-primary);
        font-weight: 600;
    }
    .quiz-root :global(.result-title) {
        font-size: 22px;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1.3;
    }
    .quiz-root :global(.result-description) {
        font-size: 15px;
        color: #374151;
        line-height: 1.7;
    }
    .quiz-root :global(.result-brechas) {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }
    .quiz-root :global(.result-brechas-title) {
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-secondary);
        margin-bottom: 2px;
    }
    .quiz-root :global(.brecha-item) {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
        background: #fef9c3;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 500;
        color: #713f12;
    }
    .quiz-root :global(.brecha-dot) {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #eab308;
        flex-shrink: 0;
    }
    /* La advertencia de que esto es una hipótesis y no un diagnóstico cerrado.
       Va legible, no en letra chica: es parte del mensaje, no un descargo. */
    .quiz-root :global(.result-caveat) {
        font-size: 14px;
        color: var(--text-secondary);
        line-height: 1.6;
        font-style: italic;
    }
    .quiz-root :global(.result-divider) {
        border: none;
        border-top: 1px solid var(--border);
    }
    .quiz-root :global(.result-cta-text) {
        font-size: 15px;
        color: var(--text-secondary);
        line-height: 1.6;
    }
    .quiz-root :global(.result-disclaimer) {
        font-size: 12px;
        color: #9ca3af;
        text-align: center;
        line-height: 1.5;
    }

    /* ─── Pantalla de carga (nueva, no existía en el original) ─── */
    .quiz-root :global(.cargando-wrapper) {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: calc(32px + var(--nav-h)) 16px 32px;
        gap: 16px;
        text-align: center;
    }
    .quiz-root :global(.cargando-spinner) {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        border: 3px solid var(--border);
        border-top-color: var(--brand);
        animation: girar 0.8s linear infinite;
    }
    @keyframes girar {
        to {
            transform: rotate(360deg);
        }
    }
    .quiz-root :global(.cargando-texto) {
        font-size: 15px;
        color: var(--text-secondary);
    }
</style>

<script is:inline>
    // ============================================================
    // Port de /root/apps/se-quiz/src/App.jsx a JS vanilla.
    // Sin React: estado en variables de módulo, render por
    // reemplazo de innerHTML del contenedor #quiz-root.
    //
    // Cambios respecto del original (ver task-3-brief.md):
    // 1. STEPS y DIAGNOSES se copian tal cual.
    // 2. El paso "contacto" pide nombre, correo e Instagram
    //    (se elimina el campo teléfono).
    // 3. La pantalla de resultado no lleva botón de agendamiento;
    //    cierra derivando a Clau/Felipe del equipo.
    // 4. Se agregan eventos GA4 (quiz_start, quiz_step,
    //    quiz_complete, quiz_submit_failed).
    // 5. El envío al webhook reintenta una vez y usa keepalive;
    //    el resultado se muestra SIEMPRE, falle o no el POST.
    //
    // Fix round 1 (revisión post-implementación):
    // - El envío tiene timeout (AbortSignal.timeout, 5s por intento) para
    //   que un POST colgado no deje a la persona varada en "cargando".
    // - Seleccionar una opción actualiza el DOM quirúrgicamente (clase
    //   .selected + aria-pressed), sin volver a reemplazar el innerHTML
    //   del paso — no pierde el foco de teclado ni re-dispara la
    //   animación de entrada en cada clic.
    // - Los valores de nombre/correo/Instagram se asignan como propiedad
    //   del DOM (input.value = ...), nunca como atributo HTML — evita
    //   la clase de bug de comillas sin escapar en un atributo.
    // - quiz_start y quiz_step se emiten una sola vez por sesión de
    //   página (flag + Set de pasos ya reportados), para no inflar el
    //   abandono-por-pregunta si la persona retrocede y reintenta.
    // ============================================================

    const WEBHOOK = "https://n8n.somosempleables.com/webhook/quiz-lead";

    // Copiado tal cual de se-quiz/src/App.jsx — no tocar el copy.
    const STEPS = [
        {
            id: "situacion",
            question: "¿Cuál es tu situación laboral actual?",
            columns: 2,
            options: [
                {
                    value: "empleado_cambio",
                    label: "Empleado, buscando algo mejor",
                    icon: "💼",
                },
                {
                    value: "desempleado",
                    label: "Desempleado, buscando activamente",
                    icon: "🔍",
                },
                {
                    value: "freelance",
                    label: "Freelance / independiente",
                    icon: "🧑‍💻",
                },
                { value: "recien_egresado", label: "Recién egresado", icon: "🎓" },
            ],
        },
        {
            id: "area",
            question: "¿En qué área profesional te desarrollas?",
            columns: 2,
            options: [
                { value: "tecnologia", label: "Tecnología e IT", icon: "💻" },
                { value: "marketing", label: "Marketing y Ventas", icon: "📊" },
                {
                    value: "finanzas",
                    label: "Finanzas y Administración",
                    icon: "📈",
                },
                { value: "rrhh", label: "Recursos Humanos", icon: "👥" },
                {
                    value: "ingenieria",
                    label: "Ingeniería y Construcción",
                    icon: "⚙️",
                },
                { value: "otra", label: "Otra área", icon: "🌐" },
            ],
        },
        {
            id: "experiencia",
            question: "¿Cuántos años de experiencia profesional tienes?",
            columns: 2,
            options: [
                { value: "0_1", label: "Menos de 1 año", icon: "🌱" },
                { value: "2_5", label: "2 a 5 años", icon: "📗" },
                { value: "6_10", label: "6 a 10 años", icon: "📘" },
                { value: "10_plus", label: "Más de 10 años", icon: "🏆" },
            ],
        },
        {
            id: "tiempo_busqueda",
            question: "¿Hace cuánto envías CVs o postulas activamente?",
            columns: 2,
            options: [
                { value: "menos_1_mes", label: "Menos de 1 mes", icon: "🌤️" },
                { value: "1_3_meses", label: "Entre 1 y 3 meses", icon: "⏳" },
                { value: "3_6_meses", label: "Entre 3 y 6 meses", icon: "📆" },
                { value: "mas_6_meses", label: "Más de 6 meses", icon: "🕰️" },
            ],
        },
        {
            id: "bloqueo",
            question:
                "¿Cuál es tu mayor obstáculo para conseguir el trabajo que quieres?",
            columns: 1,
            options: [
                { value: "cv", label: "Mi CV no refleja mi valor real", icon: "📄" },
                {
                    value: "posicionamiento",
                    label: "No sé cómo posicionarme en el mercado",
                    icon: "🎯",
                },
                {
                    value: "entrevistas",
                    label: "Las entrevistas no me salen bien",
                    icon: "🎤",
                },
                { value: "red", label: "No tengo red de contactos", icon: "🔗" },
                { value: "direccion", label: "No sé qué cargo buscar", icon: "🧭" },
            ],
        },
        {
            id: "urgencia",
            question: "¿Con qué urgencia necesitas este cambio?",
            columns: 1,
            options: [
                {
                    value: "ahora",
                    label: "Lo necesito ya — estoy buscando activamente",
                    icon: "🔥",
                },
                { value: "pronto", label: "En los próximos 3 a 6 meses", icon: "📅" },
                {
                    value: "explorando",
                    label: "Solo estoy explorando opciones",
                    icon: "🔭",
                },
            ],
        },
        {
            id: "profesion",
            type: "texto",
            question: "¿Cuál es tu profesión?",
            placeholder: "Ej: Ingeniera comercial, contador, diseñador gráfico",
        },
        {
            id: "contacto",
            type: "form",
            question: "¿A dónde enviamos tu diagnóstico?",
        },
    ];

    // Copy en clave de HIPÓTESIS, no de diagnóstico cerrado: esto sale de 5
    // respuestas de alternativas, así que no podemos afirmar el caso de nadie.
    // Debe mantenerse alineado con /root/scripts/quiz/compose.mjs, que es el
    // copy del correo (mismos títulos, cuerpo más largo).
    const DIAGNOSES = {
        cv: {
            titulo: "Probablemente tu CV no te está representando",
            descripcion:
                "Si tienes experiencia real y aun así el teléfono no suena, lo primero que solemos mirar es cómo está contada. Los reclutadores deciden en segundos, y muchas veces el problema no es lo que lograste sino cómo se lee.",
            brechas: [
                "Narrativa profesional sin estructurar",
                "Logros reales sin visibilizar",
            ],
        },
        posicionamiento: {
            titulo: "Puede que falte claridad en tu propuesta de valor",
            descripcion:
                "Cuando no está claro cómo quieres que te vean, el mercado lo decide por ti — y suele ubicarte por debajo de lo que vales. En estos casos rara vez falta experiencia; lo que falta es estrategia.",
            brechas: [
                "Perfil LinkedIn no optimizado",
                "Cargo objetivo sin definir",
            ],
        },
        entrevistas: {
            titulo: "Las entrevistas podrían estar costándote oportunidades",
            descripcion:
                "Si llegas a la entrevista, el CV y el perfil ya funcionaron: lo que estaría fallando es el cierre. Es de las cosas que más rápido mejoran con método, porque es técnica y preparación, no personalidad.",
            brechas: [
                "Sin práctica de entrevistas estructuradas",
                "Narrativa personal sin pulir",
            ],
        },
        red: {
            titulo: "Tu red podría ser tu activo sin explotar",
            descripcion:
                "Buena parte de los trabajos no llega a publicarse: se cubren por referidos. Si ese canal está apagado, estarías compitiendo sólo por la parte visible del mercado, que es donde hay más gente peleando.",
            brechas: [
                "LinkedIn sin estrategia de conexiones",
                "Sin metodología de acercamiento",
            ],
        },
        direccion: {
            titulo: "Quizás el punto de partida sea la dirección",
            descripcion:
                "Buscar sin un cargo objetivo definido suele gastar mucha energía para avanzar poco. Antes de ejecutar conviene cerrar la pregunta de hacia dónde — todo lo demás rinde más después.",
            brechas: [
                "Cargo objetivo sin definir",
                "Sin análisis de mercado para tu perfil",
            ],
        },
    };

    // ─── Estado (vanilla, sin framework) ───
    let fase = "intro"; // 'intro' | 'quiz' | 'cargando' | 'resultado'
    let paso = 0;
    const respuestas = {};
    let contacto = { nombre: "", email: "", instagram: "" };

    // Dedup de eventos GA4: sin esto, retroceder y volver a avanzar
    // (o reiniciar desde el intro) infla el denominador de abandono
    // por pregunta, que es justo la métrica que este quiz existe para
    // medir.
    let yaComenzo = false;
    const pasosReportados = new Set();

    const root = document.getElementById("quiz-root");

    // ─── Utilidades ───

    function escapeHtml(valor) {
        const div = document.createElement("div");
        div.textContent = valor ?? "";
        return div.innerHTML;
    }

    function gtagEvento(nombreEvento, params) {
        if (typeof window.gtag === "function") window.gtag("event", nombreEvento, params);
    }

    function pasoActual() {
        return STEPS[paso];
    }

    // Validación deliberadamente laxa: algo@algo.dominio. No se persigue el RFC
    // — el objetivo es atajar el typo que hace que el diagnóstico prometido no
    // llegue nunca y el lead se pierda en silencio, no rechazar correos raros
    // pero válidos.
    function emailValido(valor) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(valor.trim());
    }

    function puedeAvanzar() {
        const step = pasoActual();
        if (step.type === "form") {
            return (
                contacto.nombre.trim() !== "" &&
                emailValido(contacto.email) &&
                contacto.instagram.trim() !== ""
            );
        }
        if (step.type === "texto") {
            return (respuestas[step.id] ?? "").trim() !== "";
        }
        return !!respuestas[step.id];
    }

    // ─── Envío al webhook (con un reintento, keepalive y timeout) ───

    // Un solo intento de POST. El signal se crea de nuevo en cada llamada
    // (un AbortSignal.timeout() ya consumido no sirve para un segundo
    // intento) para que un POST que nunca responde caiga al catch en vez
    // de dejar el await colgado para siempre.
    async function intentarEnvio(payload) {
        const opciones = {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
            keepalive: true,
            signal: AbortSignal.timeout(5000),
        };
        const r = await fetch(WEBHOOK, opciones);
        return { ok: r.ok, status: r.status };
    }

    async function enviar(payload) {
        for (let intento = 0; intento < 2; intento++) {
            try {
                const r = await intentarEnvio(payload);
                if (r.ok) return true;
                // Un 4xx significa que al webhook no le sirve este payload:
                // reintentarlo con exactamente los mismos datos da el mismo
                // error y sólo deja a la persona esperando 5 segundos más.
                // Solo se reintenta lo transitorio (5xx, red, timeout).
                if (r.status >= 400 && r.status < 500) break;
            } catch (_) {
                /* red o timeout: transitorio, se reintenta */
            }
        }
        gtagEvento("quiz_submit_failed", {});
        return false;
    }

    // Regla de oro: el resultado se muestra siempre, falle o no el POST.
    async function terminar() {
        const payload = {
            ...respuestas,
            nombre: contacto.nombre,
            email: contacto.email,
            instagram: contacto.instagram,
            timestamp: new Date().toISOString(),
        };
        gtagEvento("quiz_complete", {
            bloqueo: respuestas.bloqueo,
            urgencia: respuestas.urgencia,
        });
        fase = "cargando";
        render();
        await enviar(payload); // no se ramifica por el resultado
        fase = "resultado";
        render();
    }

    // ─── Navegación ───

    // Emite "quiz_step" una sola vez por índice de paso, aunque la
    // persona retroceda y vuelva a avanzar por el mismo paso.
    function emitirPasoUnaVez(numeroPaso, stepId) {
        if (pasosReportados.has(numeroPaso)) return;
        pasosReportados.add(numeroPaso);
        gtagEvento("quiz_step", { step_number: numeroPaso + 1, step_id: stepId });
    }

    function avanzar() {
        const step = pasoActual();
        const esUltimo = paso === STEPS.length - 1;

        emitirPasoUnaVez(paso, step.id);

        if (!esUltimo) {
            paso++;
            render();
            return;
        }

        // Último paso (form) → enviar y mostrar resultado.
        terminar();
    }

    function retroceder() {
        if (paso === 0) {
            fase = "intro";
            render();
            return;
        }
        paso--;
        render();
    }

    function comenzar() {
        // "quiz_start" una sola vez por sesión de página: si la persona
        // retrocede hasta el intro y hace clic de nuevo en "Comenzar",
        // no se vuelve a contar como un inicio nuevo.
        if (!yaComenzo) {
            yaComenzo = true;
            gtagEvento("quiz_start", {});
        }
        fase = "quiz";
        paso = 0;
        render();
    }

    // ─── Templates ───

    function vistaIntro() {
        return `
            <div class="intro-wrapper">
                <div class="intro-card">
                    <div class="intro-logo">Somos Empleables</div>
                    <div class="intro-icon">🎯</div>
                    <h1 class="intro-title">Descubre qué te está frenando en tu búsqueda laboral</h1>
                    <p class="intro-subtitle">
                        Responde 7 preguntas y te entregamos un diagnóstico personalizado con las brechas exactas
                        que están bloqueando tu próximo trabajo.
                    </p>
                    <div class="intro-pills">
                        <span class="intro-pill">✓ Gratis</span>
                        <span class="intro-pill">✓ 3 minutos</span>
                        <span class="intro-pill">✓ 100% confidencial</span>
                    </div>
                    <button type="button" class="intro-btn" data-action="comenzar">
                        Comenzar evaluación gratuita →
                    </button>
                    <p class="intro-time">Sin tarjeta. Sin compromiso.</p>
                </div>
            </div>
        `;
    }

    function vistaOpciones(step) {
        return `
            <div class="options-grid grid-${step.columns}">
                ${step.options
                    .map((opt) => {
                        const seleccionada = respuestas[step.id] === opt.value;
                        return `
                            <button
                                type="button"
                                class="option-card${seleccionada ? " selected" : ""}"
                                data-action="seleccionar"
                                data-value="${escapeHtml(opt.value)}"
                                aria-pressed="${seleccionada}"
                            >
                                <span class="option-icon" aria-hidden="true">${opt.icon}</span>
                                <span class="option-label">${escapeHtml(opt.label)}</span>
                            </button>
                        `;
                    })
                    .join("")}
            </div>
        `;
    }

    // Nota: los inputs NO llevan atributo `value` en el template. El valor
    // se asigna como propiedad del DOM en sincronizarFormulario() después
    // de insertar el HTML (ver render()). Así el dato del usuario nunca
    // pasa por un atributo HTML — se evita la clase de bug de
    // escapar-comillas-en-un-atributo por completo, no se parcha.
    function vistaFormulario() {
        return `
            <div class="form-fields">
                <label class="sr-only" for="quiz-nombre">Tu nombre completo</label>
                <input
                    id="quiz-nombre"
                    type="text"
                    placeholder="Tu nombre completo"
                    class="field-input"
                    autocomplete="name"
                    data-field="nombre"
                />
                <label class="sr-only" for="quiz-email">Tu correo electrónico</label>
                <input
                    id="quiz-email"
                    type="email"
                    placeholder="Tu correo electrónico"
                    class="field-input"
                    autocomplete="email"
                    data-field="email"
                />
                <label class="sr-only" for="quiz-instagram">Tu Instagram</label>
                <input
                    id="quiz-instagram"
                    type="text"
                    placeholder="Tu Instagram (ej: @tunombre)"
                    class="field-input"
                    autocomplete="off"
                    data-field="instagram"
                />
                <p
                    id="quiz-email-error"
                    class="field-error"
                    role="alert"
                    ${mostrarErrorEmail() ? "" : "hidden"}
                >
                    Revisa tu correo: ahí te enviamos el diagnóstico completo.
                </p>
                <p class="field-consent">
                    Al continuar aceptas que te contactemos por correo.
                    Lee cómo cuidamos tus datos en nuestra
                    <a href="/privacidad">Política de Privacidad</a>.
                </p>
            </div>
        `;
    }

    // El aviso sólo aparece cuando la persona YA escribió algo que no parece un
    // correo. Mostrarlo con el campo vacío sería regañar antes de tiempo.
    function mostrarErrorEmail() {
        return contacto.email.trim() !== "" && !emailValido(contacto.email);
    }

    // Se togglea a mano, sin re-render: el handler de `input` NO redibuja el
    // paso (eso perdía el foco del teclado a cada tecla).
    function actualizarErrorEmail() {
        const aviso = root.querySelector("#quiz-email-error");
        if (aviso) aviso.hidden = !mostrarErrorEmail();
    }

    // Paso de una sola respuesta escrita. El valor NO se pone como atributo
    // `value` en el HTML: se asigna como propiedad del DOM en sincronizarTexto()
    // después de insertar el markup, igual que el formulario de contacto. Así se
    // evita por completo la clase de bug de escapar comillas en un atributo.
    function vistaTexto(step) {
        return `
            <div class="form-fields">
                <label class="sr-only" for="quiz-texto">${escapeHtml(step.question)}</label>
                <input
                    id="quiz-texto"
                    type="text"
                    placeholder="${escapeHtml(step.placeholder)}"
                    class="field-input"
                    autocomplete="organization-title"
                    data-respuesta="${step.id}"
                />
            </div>
        `;
    }

    // Conserva lo escrito al retroceder y volver a avanzar.
    function sincronizarTexto() {
        const step = pasoActual();
        if (!step || step.type !== "texto") return;
        const input = document.getElementById("quiz-texto");
        if (input) input.value = respuestas[step.id] ?? "";
    }

    // Rellena los valores de los 3 campos desde el estado `contacto`
    // como propiedad del DOM (no como atributo HTML) tras cada render
    // que incluya el formulario — necesario para conservar lo tipeado
    // al retroceder y volver a avanzar hasta este paso.
    function sincronizarFormulario() {
        const step = pasoActual();
        if (!step || step.type !== "form") return;
        const nombreInput = document.getElementById("quiz-nombre");
        const emailInput = document.getElementById("quiz-email");
        const instagramInput = document.getElementById("quiz-instagram");
        if (nombreInput) nombreInput.value = contacto.nombre;
        if (emailInput) emailInput.value = contacto.email;
        if (instagramInput) instagramInput.value = contacto.instagram;
    }

    function vistaQuiz() {
        const step = pasoActual();
        const progreso = (paso / STEPS.length) * 100;
        const esUltimo = paso === STEPS.length - 1;
        const habilitado = puedeAvanzar();

        return `
            <div class="quiz-wrapper">
                <div class="progress-bar">
                    <div class="progress-fill" style="width: ${progreso}%"></div>
                </div>
                <div class="quiz-container">
                    <div class="step-header">
                        <button type="button" class="back-btn" data-action="retroceder">← Atrás</button>
                        <span class="step-counter">${paso + 1} / ${STEPS.length}</span>
                    </div>
                    <div class="step-content">
                        <h2 class="question">${escapeHtml(step.question)}</h2>
                        ${
                            step.type === "form"
                                ? vistaFormulario()
                                : step.type === "texto"
                                  ? vistaTexto(step)
                                  : vistaOpciones(step)
                        }
                    </div>
                    <button
                        type="button"
                        class="next-btn"
                        data-action="avanzar"
                        ${habilitado ? "" : "disabled"}
                    >
                        ${esUltimo ? "Ver mi diagnóstico →" : "Siguiente →"}
                    </button>
                </div>
            </div>
        `;
    }

    function vistaCargando() {
        return `
            <div class="cargando-wrapper">
                <div class="cargando-spinner" aria-hidden="true"></div>
                <p class="cargando-texto">Preparando tu diagnóstico...</p>
            </div>
        `;
    }

    function vistaResultado() {
        const diagnostico = DIAGNOSES[respuestas.bloqueo] || DIAGNOSES.cv;
        const primerNombre = (contacto.nombre.split(" ")[0] || "").trim();

        return `
            <div class="result-wrapper">
                <div class="result-card">
                    <div class="result-check" aria-hidden="true">✓</div>
                    <div>
                        <div class="result-label">Nuestra primera hipótesis</div>
                    </div>
                    <p class="result-greeting">
                        <strong>${escapeHtml(primerNombre)}</strong>, por lo que nos contaste, esto es lo que más nos llama la atención:
                    </p>
                    <h2 class="result-title">${escapeHtml(diagnostico.titulo)}</h2>
                    <p class="result-description">${escapeHtml(diagnostico.descripcion)}</p>
                    <div class="result-brechas">
                        <div class="result-brechas-title">Qué revisaríamos contigo</div>
                        ${diagnostico.brechas
                            .map(
                                (b) => `
                            <div class="brecha-item">
                                <span class="brecha-dot" aria-hidden="true"></span>
                                ${escapeHtml(b)}
                            </div>
                        `,
                            )
                            .join("")}
                    </div>
                    <p class="result-caveat">
                        Con estas pocas preguntas no alcanzamos a ver tu caso completo — esto es un punto de partida para conversarlo, no una conclusión.
                    </p>
                    <hr class="result-divider" />
                    <p class="result-cta-text">
                        Stefano te va a escribir para conversar tu caso y confirmar si esto calza con lo que te está pasando.
                    </p>
                    <p class="result-disclaimer">
                        Te enviamos tu diagnóstico completo a ${escapeHtml(contacto.email)}.
                    </p>
                </div>
            </div>
        `;
    }

    // ─── Render ───

    function render() {
        if (fase === "intro") root.innerHTML = vistaIntro();
        else if (fase === "quiz") {
            root.innerHTML = vistaQuiz();
            sincronizarFormulario();
            sincronizarTexto();
        } else if (fase === "cargando") root.innerHTML = vistaCargando();
        else if (fase === "resultado") root.innerHTML = vistaResultado();
    }

    // Actualiza la selección de una opción sin reemplazar el innerHTML del
    // paso: evita perder el foco de teclado y evita que la animación de
    // entrada de .step-content se vuelva a disparar en cada clic (antes
    // pasaba porque seleccionar() llamaba a render(), que regenera todo
    // el paso — la persona veía la pregunta desvanecerse y reaparecer
    // cada vez que cambiaba de opinión).
    function actualizarSeleccion(step) {
        const contenedor = root.querySelector(".options-grid");
        if (contenedor) {
            contenedor.querySelectorAll(".option-card").forEach((boton) => {
                const seleccionada = boton.dataset.value === respuestas[step.id];
                boton.classList.toggle("selected", seleccionada);
                boton.setAttribute("aria-pressed", String(seleccionada));
            });
        }
        const botonAvanzar = root.querySelector('[data-action="avanzar"]');
        if (botonAvanzar) botonAvanzar.disabled = !puedeAvanzar();
    }

    // ─── Delegación de eventos (el contenedor no se reemplaza, solo su innerHTML) ───

    root.addEventListener("click", (evento) => {
        const objetivo = evento.target.closest("[data-action]");
        if (!objetivo) return;
        const accion = objetivo.dataset.action;

        if (accion === "comenzar") comenzar();
        else if (accion === "retroceder") retroceder();
        else if (accion === "avanzar") {
            if (!objetivo.disabled) avanzar();
        } else if (accion === "seleccionar") {
            const step = pasoActual();
            respuestas[step.id] = objetivo.dataset.value;
            actualizarSeleccion(step);
        }
    });

    root.addEventListener("input", (evento) => {
        const clave = evento.target.dataset.respuesta;
        if (clave) {
            respuestas[clave] = evento.target.value;
            const btn = root.querySelector('[data-action="avanzar"]');
            if (btn) btn.disabled = !puedeAvanzar();
            return;
        }
        const campo = evento.target.dataset.field;
        if (!campo) return;
        contacto[campo] = evento.target.value;
        if (campo === "email") actualizarErrorEmail();
        const boton = root.querySelector('[data-action="avanzar"]');
        if (boton) boton.disabled = !puedeAvanzar();
    });

    render();
</script>
