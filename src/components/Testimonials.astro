---
const testimonials = [
    {
        video: "https://res.cloudinary.com/denbk9c31/video/upload/v1779211017/WhatsApp_Video_2026-05-15_at_12.10.34_PM_hpkl4t.mp4",
        poster: "https://res.cloudinary.com/denbk9c31/video/upload/so_0/v1779211017/WhatsApp_Video_2026-05-15_at_12.10.34_PM_hpkl4t.jpg",
        name: "Alejandro Flores",
        role: "Ingeniero en Automatización y Control Industrial",
    },
    {
        video: "https://res.cloudinary.com/denbk9c31/video/upload/v1779211004/WhatsApp_Video_2026-05-15_at_12.09.15_PM_jvllza.mp4",
        poster: "https://res.cloudinary.com/denbk9c31/video/upload/so_0/v1779211004/WhatsApp_Video_2026-05-15_at_12.09.15_PM_jvllza.jpg",
        name: "Diego Muñoz",
        role: "Ingeniero Civil Informático",
    },
    {
        video: "https://res.cloudinary.com/denbk9c31/video/upload/v1779210950/WhatsApp_Video_2026-05-15_at_12.21.53_PM_t176u2.mp4",
        poster: "https://res.cloudinary.com/denbk9c31/video/upload/so_0/v1779210950/WhatsApp_Video_2026-05-15_at_12.21.53_PM_t176u2.jpg",
        name: "Francisca Philips",
        role: "Ingeniera Comercial",
    },
    {
        video: "https://res.cloudinary.com/denbk9c31/video/upload/v1779210924/WhatsApp_Video_2026-05-19_at_7.52.30_AM_dnxqpj.mp4",
        poster: "https://res.cloudinary.com/denbk9c31/video/upload/so_0/v1779210924/WhatsApp_Video_2026-05-19_at_7.52.30_AM_dnxqpj.jpg",
        name: "Javiera Bazaes",
        role: "Ingeniera Civil Informática",
    },
];
---

<section id="testimonios" class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6">
        <h2
            class="text-3xl md:text-4xl font-bold text-center text-slate-900 mb-4"
        >
            Resultados que <span class="text-blue-600">transforman vidas</span>
        </h2>
        <p class="text-center text-slate-500 mb-16 max-w-2xl mx-auto">
            Escucha en sus palabras cómo cambió su búsqueda laboral.
        </p>

        <!-- Grid de videos verticales: desktop 4 col, mobile scroll horizontal con snap -->
        <div
            class="flex md:grid md:grid-cols-4 gap-6 overflow-x-auto md:overflow-visible snap-x snap-mandatory pb-4 md:pb-0 -mx-6 md:mx-0 px-6 md:px-0 mb-16 scrollbar-hide"
        >
            {
                testimonials.map((t, i) => (
                    <button
                        type="button"
                        class="testimonial-card group relative shrink-0 w-[260px] md:w-auto aspect-[9/16] rounded-2xl overflow-hidden bg-slate-200 snap-center shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
                        data-video={t.video}
                        data-name={t.name}
                        data-role={t.role}
                        data-aos="fade-up"
                        data-aos-delay={i * 100}
                    >
                        <img
                            src={t.poster}
                            alt={`Testimonio de ${t.name}`}
                            class="absolute inset-0 w-full h-full object-cover"
                            loading="lazy"
                        />
                        {/* Overlay gradient */}
                        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent" />

                        {/* Play button */}
                        <div class="absolute inset-0 flex items-center justify-center">
                            <div class="w-16 h-16 rounded-full bg-white/95 backdrop-blur-sm flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:bg-blue-600 transition-all duration-300">
                                <svg
                                    class="w-6 h-6 text-blue-600 group-hover:text-white transition-colors ml-1"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path d="M8 5v14l11-7z" />
                                </svg>
                            </div>
                        </div>

                        {/* Label inferior */}
                        <div class="absolute bottom-0 left-0 right-0 p-4 text-left">
                            <p class="text-white font-bold text-sm">{t.name}</p>
                            <p class="text-white/80 text-xs">{t.role}</p>
                        </div>
                    </button>
                ))
            }
        </div>

        <!-- Metric Highlight -->
        <div
            class="bg-slate-900 rounded-3xl p-8 md:p-12 text-center text-white relative overflow-hidden"
            data-aos="zoom-in"
        >
            <div
                class="absolute top-0 right-0 -translate-y-1/2 translate-x-1/2 w-64 h-64 bg-blue-600 rounded-full blur-3xl opacity-20"
            >
            </div>
            <div class="relative z-10">
                <p
                    class="text-blue-400 font-semibold tracking-wide uppercase text-sm mb-4"
                >
                    Impacto Real
                </p>
                <h3 class="text-4xl md:text-5xl font-bold mb-6">
                    +60k Profesionales en nuestra red
                </h3>
                <div
                    class="flex flex-wrap justify-center gap-8 md:gap-16 text-center mb-8 mt-8"
                >
                    <div>
                        <span class="block text-3xl font-bold text-white mb-1"
                            >+80</span
                        >
                        <span class="text-sm text-slate-400"
                            >Reubicados con Éxito</span
                        >
                    </div>
                    <div>
                        <span class="block text-3xl font-bold text-white mb-1"
                            >+200</span
                        >
                        <span class="text-sm text-slate-400"
                            >Miembros en Comunidad</span
                        >
                    </div>
                    <div>
                        <span class="block text-3xl font-bold text-white mb-1"
                            >+60k</span
                        >
                        <span class="text-sm text-slate-400"
                            >Seguidores en RRSS</span
                        >
                    </div>
                </div>
                <p class="text-slate-300 max-w-2xl mx-auto text-lg mb-8">
                    Nuestra metodología no es teoría, son resultados probados en
                    el mercado actual. Únete a los casos de éxito.
                </p>
                <a
                    href="#contacto"
                    class="inline-block bg-white text-slate-900 px-8 py-3 rounded-full font-bold hover:bg-blue-50 transition-colors"
                >
                    Ver más casos de éxito
                </a>
            </div>
        </div>
    </div>

    <!-- Modal lightbox para reproducir el video con audio -->
    <div
        id="video-modal"
        class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/90 backdrop-blur-sm p-4"
        role="dialog"
        aria-modal="true"
    >
        <button
            id="video-modal-close"
            class="absolute top-4 right-4 w-12 h-12 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors"
            aria-label="Cerrar"
        >
            <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>

        <div class="relative max-h-[90vh] aspect-[9/16] w-auto h-full max-w-full">
            <video
                id="video-modal-player"
                class="w-full h-full rounded-2xl bg-black"
                controls
                playsinline
                preload="metadata"
            >
            </video>
        </div>
    </div>
</section>

<style>
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }
    .scrollbar-hide {
        scrollbar-width: none;
    }
</style>

<script>
    const modal = document.getElementById("video-modal") as HTMLDivElement;
    const player = document.getElementById(
        "video-modal-player",
    ) as HTMLVideoElement;
    const closeBtn = document.getElementById(
        "video-modal-close",
    ) as HTMLButtonElement;
    const cards = document.querySelectorAll<HTMLButtonElement>(
        ".testimonial-card",
    );

    function openModal(src: string) {
        if (!modal || !player) return;
        player.src = src;
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
        player.play().catch(() => {
            /* autoplay bloqueado: el usuario puede darle play manualmente */
        });
    }

    function closeModal() {
        if (!modal || !player) return;
        player.pause();
        player.removeAttribute("src");
        player.load();
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        document.body.style.overflow = "";
    }

    cards.forEach((card) => {
        card.addEventListener("click", () => {
            const src = card.dataset.video;
            if (src) openModal(src);
        });
    });

    closeBtn?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !modal.classList.contains("hidden"))
            closeModal();
    });
</script>
