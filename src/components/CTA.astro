---

---

<section
    id="contacto"
    class="py-24 bg-linear-to-br from-blue-600 to-purple-700 relative overflow-hidden"
>
    <!-- Background patterns -->
    <div class="absolute inset-0 opacity-10 background-pattern">
        <svg
            class="w-full h-full"
            width="100%"
            height="100%"
            xmlns="http://www.w3.org/2000/svg"
        >
            <defs>
                <pattern
                    id="grid"
                    width="40"
                    height="40"
                    patternUnits="userSpaceOnUse"
                >
                    <path
                        d="M 40 0 L 0 0 0 40"
                        fill="none"
                        stroke="white"
                        stroke-width="1"></path>
                </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#grid)"></rect>
        </svg>
    </div>

    <div class="max-w-4xl mx-auto px-6 text-center relative z-10">
        <h2
            class="text-4xl md:text-5xl font-bold text-white mb-6 leading-tight"
        >
            ¿Listo para dejar de buscar y <br /> empezar a encontrar?
        </h2>
        <p class="text-xl text-blue-100 mb-10 max-w-2xl mx-auto">
            Da el primer paso hoy. Responde esta encuesta para reservar tu
            diagnóstico gratuito o solicitar más información.
        </p>

        <a
            href="/quiz"
            class="group inline-flex items-center justify-center gap-2 bg-white text-slate-900 px-10 py-5 rounded-xl font-bold text-lg hover:bg-blue-50 hover:shadow-2xl hover:-translate-y-0.5 transition-all duration-300"
        >
            <span>Quiero mi Estrategia</span>
            <svg
                class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg
            >
        </a>

        <p class="mt-8 text-sm text-blue-200">
            Respondes unas preguntas y recibes tu diagnóstico en el correo.
        </p>
    </div>
</section>
